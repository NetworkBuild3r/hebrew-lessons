# ElevenLabs (never commit the real .env)
# Either name works. In k8s, inject as ELEVENLABS_API_KEY from the vault/secret.
11_labs_api_key=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=6WRlPmU1fqPwYbSxeP16
# Hebrew needs v3/v4 — not eleven_multilingual_v2
ELEVENLABS_MODEL=eleven_v3

# First admin. Used only when the database has no admin user.
# Once an admin exists, these are ignored. In k8s, inject both from the vault Secret.
# Password: at least 10 characters, not a common password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=

# Image generation (OpenAI). Never commit a value.
# In k8s, inject OPENAI_API_KEY from Secret hebrew-secrets. See deploy/k8s-database.md.
OPENAI_API_KEY=

# MCP. MCP_AUTH_TOKEN signs issued OAuth tokens and still works as a bearer for scripts.
# MCP_PUBLIC_URL is the https origin clients use, with no path (example: https://mcp.example.com).
MCP_AUTH_TOKEN=
MCP_PUBLIC_URL=

# Google sign-in for the MCP consent page. Use the same client id and secret as oauth2-proxy
# (the Google client that protects Tautulli). Leave both empty to keep the token form.
# On that Google client, add these redirect URIs and keep the existing Tautulli one
# (https://auth.ibhacked.us/oauth2/callback):
#   {PUBLIC_ORIGIN}/api/auth/google/callback
#   {MCP_PUBLIC_URL}/oauth/google/callback
# MCP_OAUTH_ALLOWED_EMAILS is a comma-separated list. If the two Google variables are set
# and this list is empty, sign-in is refused.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Or the names already used for that Google client:
# web_client_id= and web_client_secret= (preferred when both pairs are set)
# client_id= and client_secret= (oauth2-proxy / Tautulli)
MCP_OAUTH_ALLOWED_EMAILS=

# Review scheduler: ladder (default) or fsrs. Not a secret. Read once at process start.
# Leave unset or ladder until the language-program rollout step that flips to fsrs.
# See docs/operations/language-program-rollout.md and accounts-and-admin.md (Ladder fallback).
SRS_SCHEDULER=

# Login throttle and CSRF scheme. Comma-separated IPv4 or IPv6 addresses or
# CIDRs of proxies that may supply CF-Connecting-IP and X-Forwarded-Proto.
# Empty trusts nobody: the throttle uses the socket address, and the CSRF host
# origin uses the socket's TLS state. Not a secret. Invalid entries are ignored
# at startup with one warning.
# Note for the team lead (Hebrew Dev) and CI/CD: production is Cloudflare, then
# Traefik. Set this to Traefik's pod CIDR before or with deploy, and confirm
# Traefik passes CF-Connecting-IP through untouched. Traefik appends its scheme
# onto X-Forwarded-Proto; a trusted peer uses that rightmost http or https.
# Until the list is set, every sign-in shares the Traefik peer's bucket.
# If this is empty (or unset) and PUBLIC_ORIGIN starts with https://, startup
# prints a multi-line warning and still boots. Behind Traefik the socket is
# plain HTTP, so the CSRF host origin is http://. A browser write whose Origin
# is not exactly PUBLIC_ORIGIN then returns 403. Set this to the proxy CIDR
# to clear that warning.
# See deploy/k8s-database.md.
TRUSTED_PROXIES=
