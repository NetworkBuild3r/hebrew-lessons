package views

// LearnIndex lists published explainers in path order.
// The first one is the featured note. Every note is also a card.
templ LearnIndex(v LearnIndexView) {
	@Layout(v.Page) {
		<article class="learn learn-index">
			<header class="learn-index__head">
				<p class="eyebrow" lang="en">Grammar and usage</p>
				<h1>
					<span lang="en">Learn</span>
					<bdi class="he" lang="he" dir="rtl">מַדְרִיכִים</bdi>
				</h1>
				<p class="learn-index__lede" lang="en">Short explainers. Read one before a lesson, or come back when something feels tricky.</p>
			</header>
			if len(v.Groups) == 0 {
				<div class="learn-empty">
					<p class="he" lang="he" dir="rtl">עֲדַיִן אֵין מַדְרִיכִים</p>
					<p lang="en">Grammar notes gather here as they are published.</p>
				</div>
			} else {
				<a class="learn-hero" href={ templ.SafeURL(v.Page.Href("/learn/" + v.Groups[0].Slug)) }>
					<img class="learn-hero__art" src="/static/illustrations/hero-skyline-night.svg" alt=""/>
					<p class="eyebrow" lang="en">Start here</p>
					if v.Groups[0].Example != "" {
						<bdi class="he learn-hero__he" lang="he" dir="rtl">{ v.Groups[0].Example }</bdi>
					}
					<span class="learn-hero__title" lang="en">{ v.Groups[0].Title }</span>
					if v.Groups[0].Summary != "" {
						<span class="learn-hero__summary">{ v.Groups[0].Summary }</span>
					}
					<span class="btn">Read</span>
				</a>
				<p class="learn-index__count" lang="en">{ learnCount(len(v.Groups)) }</p>
				<ul class="learn-grid">
					for _, g := range v.Groups {
						<li>
							<a class="learn-card" href={ templ.SafeURL(v.Page.Href("/learn/" + g.Slug)) }>
								if g.Cover != "" {
									<img class="learn-card__art" src={ templ.SafeURL(g.Cover) } alt=""/>
								}
								<span class="learn-card__body">
									if g.Example != "" {
										<bdi class="he learn-card__he" lang="he" dir="rtl">{ g.Example }</bdi>
									}
									<span class="learn-card__title">{ g.Title }</span>
									if g.Summary != "" {
										<span class="learn__summary">{ g.Summary }</span>
									}
								</span>
							</a>
						</li>
					}
				</ul>
			}
		</article>
	}
}

// LearnPage is one explainer, with the lessons that teach it.
templ LearnPage(v LearnPageView) {
	@Layout(v.Page) {
		<article class="learn learn-page">
			<a class="learn-back" href={ templ.SafeURL(v.Page.Href("/learn")) } lang="en">Learn</a>
			<h1 lang="en">{ v.Title }</h1>
			<div class="learn__body">
				@Rich(v.Nodes)
			</div>
			if len(v.Often) > 0 {
				<h2 lang="en">Learners often say</h2>
				<ul class="learn__often">
					for _, row := range v.Often {
						<li>
							<p>
								<bdi class="he" lang="he" dir="rtl">{ row.Wrong }</bdi>
								@IconClass("arrow-right", "icon icon-sm", "")
								<bdi class="he" lang="he" dir="rtl">{ row.Right }</bdi>
							</p>
							if row.Explain != "" {
								<p class="learn__summary" lang="en">{ row.Explain }</p>
							}
						</li>
					}
				</ul>
			}
			if len(v.Used) > 0 {
				<h2 lang="en">Used in</h2>
				<ul class="learn__used">
					for _, u := range v.Used {
						<li><a href={ templ.SafeURL(u.Href) }>{ u.Title }</a></li>
					}
				</ul>
			}
		</article>
	}
}

// LearnSheet is the fragment a lesson loads into the dialog.
templ LearnSheet(v LearnSheetView) {
	<h2 id="how-title" lang="en">{ v.Title }</h2>
	<div class="learn__body">
		@Rich(v.Nodes)
	</div>
}
