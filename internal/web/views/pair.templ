package views

// Pair is the only Hebrew/English pair in the shell.
// Each run sits in its own bdi. The gap is CSS, never punctuation.
templ Pair(uiLang, he, en string) {
	<span class="pair">
		if uiLang == "en" {
			@E(en)
			@H(he)
		} else {
			@H(he)
			@E(en)
		}
	</span>
}

// E isolates one English run.
templ E(text string) {
	<bdi lang="en" dir="ltr">{ text }</bdi>
}

// H isolates one Hebrew run.
templ H(text string) {
	<bdi lang="he" dir="rtl">{ text }</bdi>
}

// uiRun isolates a string in the UI language.
templ uiRun(lang, text string) {
	if lang == "en" {
		@E(text)
	} else {
		@H(text)
	}
}

// MixedEN renders an English sentence. Each Hebrew run is its own bdi.
templ MixedEN(text string) {
	for _, run := range MixedRuns(text) {
		if run.Hebrew {
			@H(run.Text)
		} else {
			{ run.Text }
		}
	}
}

// LessonName is a unit title. An English title stays left to right.
// A title that contains Hebrew isolates each Hebrew run.
templ LessonName(text string) {
	if HasHebrew(text) {
		@MixedEN(text)
	} else {
		@E(text)
	}
}

// Situation is the English line under a lesson title.
// The block itself is LTR so the sentence's punctuation stays at the end.
// A Hebrew word inside the sentence sits in its own bdi.
templ Situation(text string) {
	<p class="situation" lang="en" dir="ltr">
		if HasHebrew(text) {
			@MixedEN(text)
		} else {
			@E(text)
		}
	</p>
}
