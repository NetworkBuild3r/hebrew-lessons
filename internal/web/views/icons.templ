package views

// Icon draws one sprite icon at the default 24px size. With no label the
// icon is decoration: aria-hidden, so a screen reader skips it. With a label
// it is meaningful: role="img" with a title and the same name as aria-label.
templ Icon(name, label string) {
	@IconClass(name, "icon", label)
}

// IconClass is Icon with a class list, for the 20px size ("icon icon-sm") or a
// mirrored arrow ("icon icon-directional").
templ IconClass(name, class, label string) {
	if label == "" {
		<svg class={ class } aria-hidden="true" focusable="false"><use href={ safeURL(iconRef(name)) }></use></svg>
	} else {
		<svg class={ class } role="img" aria-label={ label } focusable="false"><title>{ label }</title><use href={ safeURL(iconRef(name)) }></use></svg>
	}
}

// Illustration draws one themed illustration. The artwork uses var(--token)
// fills, so it follows light and dark. With no label it is decoration. Give a
// label only when the picture carries information the text beside it does not.
templ Illustration(name, label string) {
	if ref := illustrationRef(name); ref != "" {
		if label == "" {
			<svg class="illo" viewBox="0 0 240 160" aria-hidden="true" focusable="false"><use href={ safeURL(ref) }></use></svg>
		} else {
			<svg class="illo" viewBox="0 0 240 160" role="img" aria-label={ label } focusable="false"><title>{ label }</title><use href={ safeURL(ref) }></use></svg>
		}
	}
}

// BrandMark is the lamp glyph inside the .brand__mark tile. The tile is
// always dark, so the glyph reads in light and dark. The wordmark stays live
// text beside it, in the bundled display font.
templ BrandMark() {
	<svg class="brand__glyph" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><use href={ safeURL(brandGlyphHref) }></use></svg>
}

// brandHead is the favicon, manifest link, and icons stylesheet for a page head.
templ brandHead() {
	<link rel="icon" href={ safeURL(faviconHref) } type="image/svg+xml"/>
	<link rel="manifest" href={ safeURL(manifestHref) }/>
	<link rel="stylesheet" href={ safeURL(iconsCSSHref) }/>
}

// googleMark is the official multicolour G. The paths are unmodified. It
// lives here with the other inline SVG; Google fixes these colours.
templ googleMark() {
	<span class="gbtn__mark" aria-hidden="true">
		<svg class="gbtn__logo" viewBox="0 0 48 48" focusable="false">
			<path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
			<path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
			<path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
			<path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
			<path fill="none" d="M0 0h48v48H0z"></path>
		</svg>
	</span>
}
