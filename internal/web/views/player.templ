package views

// Lesson is the player. An empty screen says no lesson is published.
// A lesson shows one activity inside the lesson frame (lessonframe.templ).
// htmx swaps #lesson-frame; the shell stays.
templ Lesson(p Page, s Screen) {
	@Layout(p) {
		if s.Empty {
			<article class="sheet lesson-player">
				<h1 lang={ p.Lang }>{ p.LessonHeading }</h1>
				<section class="quiet-card quiet-card--next">
					<p class="eyebrow" lang={ p.Lang }>{ p.NextKicker }</p>
					@Icon("lessons", "")
					<p class="quiet-card__line">
						@Pair(p.Lang, p.NoneHE, p.NoneEN)
					</p>
					<p class="quiet-card__hint">
						@Pair(p.Lang, p.NoneMoreHE, p.NoneMoreEN)
					</p>
					<a class="btn btn-tonal" href={ templ.SafeURL(p.Href("/progress")) }>
						<span>@uiRun(p.Lang, p.Progress)</span>
					</a>
				</section>
			</article>
		} else {
			@LessonFrameView(p, s)
		}
	}
}

// ActivityBlock is the step inside the lesson frame. The completion panel uses the same id.
// An answer is a c-answer button: it posts the form, and the frame comes back swapped.
templ ActivityBlock(a Activity) {
	<div id="activity" class="activity">
		if a.Done {
			<p class="lede" lang="en">@E("Lesson complete.")</p>
			if a.Score != "" {
				<p class="count"><bdi lang="en" dir="ltr">{ a.Score }</bdi></p>
			}
			<a class="btn btn-primary" href={ templ.SafeURL(a.HomeHref) }>@E("Back to Today")</a>
		} else {
			if a.PromptWord != "" {
				<p class="lede" lang="en">@E("What does ")<bdi class="recall-prompt" lang="he" dir="rtl">{ a.PromptWord }</bdi>@E(" mean?")</p>
			} else if a.Prompt != "" {
				<p class="lede" lang="en">@E(a.Prompt)</p>
			}
			if a.Dialogue != nil {
				@dialogueBlock(a.Dialogue)
			}
			if a.Audio != "" {
				@clip("line-clip", a.Audio, a.AudioLabel, true)
			}
			if len(a.Words) > 0 {
				<div class={ wordBlocksClass(a) } dir="rtl">
					for i, word := range a.Words {
						@activityWord(word, "word-clip-"+Num(i), a.PromptWord != "")
					}
				</div>
			}
			<form method="post" action={ templ.SafeURL(a.Post) } hx-post={ a.Post } hx-target="#lesson-frame" hx-swap="outerHTML" hx-select="unset" hx-boost="false">
				<input type="hidden" name="_csrf" value={ a.CSRF }/>
				<input type="hidden" name="run" value={ a.Run }/>
				if a.Asking {
					<div class="choices">
						for _, choice := range a.Choices {
							@choiceButton(choice)
						}
					</div>
				} else if a.Feedback != "" {
					<div class="lf-result">
						@Sheet("Answer") {
							<p class={ a.FeedbackClass } lang="en">@E(a.Feedback)</p>
							<button type="submit" class="btn btn-primary" name="answer" value="continue" autofocus>@E(a.Continue)</button>
						}
					</div>
				} else {
					<button type="submit" class="btn btn-primary" name="answer" value="continue">@E(a.Continue)</button>
				}
			</form>
			if hasClip(a) {
				<script src="/static/js/clips.js" defer></script>
			}
		}
	</div>
}

// activityWord is one token. A gap is the cloze blank. A visible word uses
// the shared word block, with any hidden field passed empty. audioID names
// the clip element when the word has one. A tested word in a multi-word
// recall is a mark, with a dashed slot where its gloss will be. rows lays
// that recall line on a shared grid: Hebrew, transliteration, gloss, orb.
templ activityWord(w Word, audioID string, rows bool) {
	if w.Plain {
		@E(w.Text)
	} else if w.Gap {
		<span class="word-block word-block--gap">@E("___")</span>
	} else if rows {
		<span class="activity-word">
			<span class="wb wb--card">
				<span class="recall-he">
					if w.Target {
						<mark class="target"><bdi class="wb__he" lang="he" dir="rtl">{ w.Text }</bdi></mark>
					} else {
						<bdi class="wb__he" lang="he" dir="rtl">{ w.Text }</bdi>
					}
					if w.ShowText && GenderLabel(w.Gender) != "" {
						<span class="gchip">@H(GenderLabel(w.Gender))</span>
					}
				</span>
				<span class="recall-tr">
					if w.ShowTranslit && w.Translit != "" {
						<bdi class="wb__tr" lang="he-Latn" dir="ltr">{ w.Translit }</bdi>
					}
				</span>
				<span class="recall-gl">
					if w.Target && w.ShowGloss && w.Gloss != "" {
						<bdi class="wb__gl target-slot target-slot--filled" lang="en" dir="ltr">{ w.Gloss }</bdi>
					} else if w.Target {
						<span class="target-slot" lang="en" aria-hidden="true">?</span>
					} else if w.ShowGloss && w.Gloss != "" {
						<bdi class="wb__gl" lang="en" dir="ltr">{ w.Gloss }</bdi>
					}
				</span>
			</span>
			if w.Audio != "" {
				@clip(audioID, w.Audio, "Play "+w.Text, false)
			} else {
				<span class="recall-clip"></span>
			}
		</span>
	} else {
		<span class="activity-word">
			if w.Target {
				@targetWord(w)
			} else if w.ShowText || w.ShowTranslit || w.ShowGloss {
				@WordBlock(shown(w.ShowText, w.Text), shown(w.ShowTranslit, w.Translit), shown(w.ShowGloss, w.Gloss), "card", "", !w.ShowGloss)
			}
			if w.ShowText && GenderLabel(w.Gender) != "" {
				<span class="gchip">@H(GenderLabel(w.Gender))</span>
			}
			if w.Audio != "" {
				@clip(audioID, w.Audio, "Play "+w.Text, false)
			}
		</span>
	}
}

// targetWord is the word a multi-word recall asks about. The mark is how a
// screen reader hears it as highlighted. Its transliteration stays hidden
// until the answer. The gloss is a dashed slot until then, then the meaning.
templ targetWord(w Word) {
	<span class="wb wb--card">
		<mark class="target"><bdi class="wb__he" lang="he" dir="rtl">{ w.Text }</bdi></mark>
		if w.ShowTranslit && w.Translit != "" {
			<bdi class="wb__tr" lang="he-Latn" dir="ltr">{ w.Translit }</bdi>
		}
		if w.ShowGloss && w.Gloss != "" {
			<bdi class="wb__gl target-slot target-slot--filled" lang="en" dir="ltr">{ w.Gloss }</bdi>
		} else {
			<span class="target-slot" lang="en" aria-hidden="true">?</span>
		}
	</span>
}

// choiceButton is one answer: a c-answer submit button. The lesson has no
// key badge: nothing in the player tells the learner to press 1, 2, or 3.
// The value is the lexeme id, never the pointed text.
templ choiceButton(c Choice) {
	@AnswerOptionWith(AnswerDefault, "", templ.Attributes{"type": "submit", "name": "answer", "value": c.Value}) {
		if c.Hebrew {
			@WordBlock(c.Text, c.Translit, "", "chip", "", true)
		} else {
			@E(c.Label)
		}
	}
}

// dialogueBlock is a conversation, one line at a time in spoken order. Each line
// has the speaker's fixed name, the words with sound and meaning, and a play
// control for that line alone. "Play the conversation" plays every line in order
// (dialogue.js). A line with no clip has no control, and is never played in the
// other speaker's voice. Nothing here is an answer option, so no c-answer.
templ dialogueBlock(d *Dialogue) {
	<div class="dlg" data-dialogue>
		<p class="dlg__bar">
			@ButtonWith(ButtonQuiet, templ.Attributes{"data-dlg-all": "", "aria-pressed": "false"}) {
				@E("Play the conversation")
			}
		</p>
		<ol class="dlg__lines">
			for _, line := range d.Lines {
				<li class={ dialogueLineClass(line.Speaker) } data-speaker={ line.Speaker } data-line={ Num(line.Index) }>
					<p class="dlg__who" lang="en">{ line.Name }</p>
					<div class="dlg__bubble">
						<div class="word-blocks" dir="rtl">
							for _, word := range line.Words {
								@activityWord(word, "", false)
							}
						</div>
						if line.Audio != "" {
							<audio id={ dialogueClipID(line.Index) } src={ templ.SafeURL(line.Audio) } preload="none" data-dlg-clip={ Num(line.Index) }></audio>
							@AudioOrb("Play line "+Num(line.Index+1)+", "+line.Name, dialogueOrbAttrs(line.Index))
						}
					</div>
				</li>
			}
		</ol>
	</div>
	<script src="/static/js/dialogue.js" defer></script>
}

// clip is one recording in the lesson player. The server always renders the
// native audio (the no-JS bar) and a button.orb. clips.js adds class js on
// html, which shows the orb and hides the bar. hero is the line control.
// label is the button's accessible name, such as "Play אֲנִי" or "Play the line".
templ clip(id, src, label string, hero bool) {
	<div class={ clipClass(hero) }>
		<audio id={ id } src={ templ.SafeURL(src) } preload="none" controls></audio>
		<button type="button" class={ orbClass(hero) } aria-label={ label } data-label={ label } data-src={ src } data-state="idle">
			<span class="orb__glyph orb__glyph--play">@Icon("play", "")</span>
			<span class="orb__glyph orb__glyph--load" aria-hidden="true"></span>
			<span class="orb__glyph orb__glyph--dots">@Icon("dots", "")</span>
			<span class="orb__glyph orb__glyph--stop">@Icon("stop", "")</span>
			<span class="orb__glyph orb__glyph--off">@Icon("audio-off", "")</span>
		</button>
	</div>
}
