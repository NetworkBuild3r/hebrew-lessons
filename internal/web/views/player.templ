package views

// Lesson is the player. An empty screen says no lesson is published.
// A lesson shows one activity inside the lesson frame (lessonframe.templ).
// htmx swaps #lesson-frame; the shell stays.
templ Lesson(p Page, s Screen) {
	@Layout(p) {
		if s.Empty {
			<article class="sheet lesson-player">
				<h1 lang={ p.Lang }>{ p.LessonHeading }</h1>
				<section class="quiet-card quiet-card--next">
					<p class="eyebrow" lang={ p.Lang }>{ p.NextKicker }</p>
					@Icon("lessons", "")
					<p class="quiet-card__line">
						@Pair(p.Lang, p.NoneHE, p.NoneEN)
					</p>
					<p class="quiet-card__hint">
						@Pair(p.Lang, p.NoneMoreHE, p.NoneMoreEN)
					</p>
					<a class="btn btn-tonal" href={ templ.SafeURL(p.Href("/progress")) }>
						<span>@uiRun(p.Lang, p.Progress)</span>
					</a>
				</section>
			</article>
		} else {
			@LessonFrameView(p, s)
		}
	}
}

// ActivityBlock is the step inside the lesson frame. The completion panel uses the same id.
// An answer is a c-answer button: it posts the form, and the frame comes back swapped.
templ ActivityBlock(a Activity) {
	<div id="activity" class="activity">
		if a.Done {
			<p class="lede" lang="en">@E("Lesson complete.")</p>
			if a.Score != "" {
				<p class="count"><bdi lang="en" dir="ltr">{ a.Score }</bdi></p>
			}
			<div class="activity__done">
				if a.NextHref != "" {
					<a class="btn btn-primary" href={ templ.SafeURL(a.NextHref) }>@E("Next lesson")</a>
					<a class="btn btn-tonal" href={ templ.SafeURL(a.HomeHref) }>@E("Back to Today")</a>
				} else {
					<a class="btn btn-primary" href={ templ.SafeURL(a.HomeHref) }>@E("Back to Today")</a>
				}
			</div>
		} else {
			if a.Cue != "" {
				<p class="say-cue" lang="en">{ a.Cue }</p>
			}
			if a.PromptWord != "" {
				<p class="lede" lang="en">@E("What does ")<bdi class="recall-prompt" lang="he" dir="rtl">{ a.PromptWord }</bdi>@E(" mean?")</p>
			} else if a.Prompt != "" {
				<p class="lede" lang="en">@E(a.Prompt)</p>
			}
			if a.HowHref != "" {
				<a class="how" href={ templ.SafeURL(a.HowHref) } hx-get={ a.HowSheet } hx-target="#how-body" hx-swap="innerHTML" hx-boost="false">How this works</a>
				<dialog id="how-sheet" class="how-sheet" aria-labelledby="how-title">
					<div id="how-body"></div>
					<button type="button" class="how-sheet__close" data-close-sheet>Close</button>
				</dialog>
			}
			if flipCount(a) > 0 {
				@flipHint(a)
			}
			if a.Dialogue != nil && flipCount(a) >= 2 {
				@showMeanings(a)
			}
			if a.Dialogue != nil {
				@dialogueBlock(a.Dialogue)
			}
			if a.Spotlight && len(a.Words) > 0 {
				<section class="spotlight spotlight--cards">
					<div class="wline" dir="rtl">
						for i, word := range a.Words {
							@activityWord(word, "word-clip-"+Num(i))
						}
					</div>
					if a.Audio != "" && (len(a.Words) > 1 || a.Words[0].Audio == "") {
						@lineClip(a)
					}
				</section>
			} else {
				if a.Stage && a.Audio != "" {
					<div class="listen-stage">
						@lineClip(a)
					</div>
				} else if a.Audio != "" && !teachLine(a) {
						@lineClip(a)
				}
			}
			if a.Dialogue == nil && flipCount(a) >= 2 {
				@showMeanings(a)
			}
			if len(a.Words) > 0 && !a.Spotlight {
				<div class={ wordBlocksClass(a) } dir="rtl">
					for i, word := range a.Words {
						@activityWord(word, "word-clip-"+Num(i))
					}
				</div>
				if teachLine(a) && a.Audio != "" {
					<div class="wline-play">
						@lineClip(a)
					</div>
				}
			}
			if clipRows(a) {
				<div class="clip-rows">
					for i, word := range a.Words {
						if word.Flip && word.Audio != "" {
							@wordClipRow(word, "word-clip-"+Num(i))
						}
					}
				</div>
			}
			<form method="post" action={ templ.SafeURL(a.Post) } hx-post={ a.Post } hx-target="#lesson-frame" hx-swap="outerHTML" hx-select="unset" hx-boost="false">
				<input type="hidden" name="_csrf" value={ a.CSRF }/>
				<input type="hidden" name="run" value={ a.Run }/>
				if a.Dialogue != nil && a.Dialogue.Offer {
					<div class="act__grades say-grades">
						<button type="submit" class="act-grade" name="answer" value="side-a">@E("Say Dana's lines")</button>
						<button type="submit" class="act-grade" name="answer" value="side-b">@E("Say Avi's lines")</button>
					</div>
				}
				if a.LineNext {
					<button type="submit" class="btn btn-primary" name="answer" value="next">@E("Next")</button>
				} else if a.SayAsk {
					<button type="submit" class="btn btn-primary" name="answer" value="said" autofocus>@E("I said it")</button>
				} else if a.Say {
					<p class="lede" lang="en" id="say-grade">@E("How did that go?")</p>
					<div class="act__grades say-grades" role="group" aria-labelledby="say-grade">
						<button type="submit" class="act-grade" name="answer" value="got">@E("Got it")</button>
						<button type="submit" class="act-grade" name="answer" value="notyet">@E("Not yet")</button>
					</div>
				} else if a.Asking {
					<div class="choices">
						for _, choice := range a.Choices {
							@choiceButton(choice)
						}
					</div>
				} else if a.Feedback != "" {
					<div class="lf-result">
						@Sheet("Answer") {
							<p class={ a.FeedbackClass } lang="en">@E(a.Feedback)</p>
							<button type="submit" class="btn btn-primary" name="answer" value="continue" autofocus>@E(a.Continue)</button>
						}
					</div>
				} else {
					<button type="submit" class="btn btn-primary" name="answer" value="continue">@E(a.Continue)</button>
				}
			</form>
			if hasClip(a) {
				<script src={ Asset("/static/js/clips.js") } defer></script>
			}
			if flipCount(a) > 0 {
				<script type="module" src={ Asset("/static/js/wcards.js") }></script>
			}
		}
	</div>
}

// activityWord is one token. A gap is the cloze blank. A word that is a card (Flip) is a
// wordCard with its play control joined under it. Any other visible word is the shared word
// block, with any hidden field passed empty. audioID names the clip element when the word
// has one.
templ activityWord(w Word, audioID string) {
	if w.Plain {
		if w.Flip {
			<span class="wpunct" lang="he">{ w.Text }</span>
		} else {
			@E(w.Text)
		}
	} else if w.Gap {
		<span class="word-block word-block--gap">@E("___")</span>
	} else if w.Flip {
		<div class="wslot">
			@wordCard(w)
			if w.Audio != "" {
				<div class="clip">
					@orbButton(orbClass(false), "Play "+w.Text, w.Audio, audioID)
				</div>
			}
		</div>
	} else {
		<span class="activity-word">
			if w.ShowText || w.ShowTranslit || w.ShowGloss {
				@WordBlock(shown(w.ShowText, w.Text), shown(w.ShowTranslit, w.Translit), shown(w.ShowGloss, w.Gloss), "card", "", !w.ShowGloss)
			}
			if w.ShowText && GenderLabel(w.Gender) != "" {
				<span class="gchip">@H(GenderLabel(w.Gender))</span>
			}
			if w.Audio != "" {
				@clip(audioID, w.Audio, "Play "+w.Text, false)
			}
		</span>
	}
}
// wordCard is one teach-step word. The summary is the front (Hebrew and
// transliteration). The meaning sits in the details, so a tap flips it and
// a browser without script still opens it. The play control stays outside.
templ wordCard(w Word) {
	<details class={ wcardClass(w) } open?={ w.Open }>
		<summary class="wcard__hit">
			<span class="wcard__face wcard__front">
				if w.New {
					<span class="wcard__new" lang="en">New</span>
				}
				if w.State != "" {
					<span class="wcard__state" lang="en">{ w.State }</span>
				}
				if w.Target {
					<mark class="target"><bdi class="wcard__he" lang="he" dir="rtl">{ w.Text }</bdi></mark>
				} else {
					<bdi class="wcard__he" lang="he" dir="rtl">{ w.Text }</bdi>
				}
				if w.ShowTranslit && w.Translit != "" {
					<bdi class="wcard__tr" lang="he-Latn" dir="ltr">{ w.Translit }</bdi>
				}
			</span>
		</summary>
		<div class="wcard__face wcard__back" lang="en" dir="ltr">
			<bdi class="wcard__he-sm" lang="he" dir="rtl">{ w.Text }</bdi>
			if w.ShowGloss {
				if meaning, note, lemma := SplitGloss(w.Gloss); meaning != "" {
					<span class="wcard__gl">{ meaning }</span>
					if note != "" || lemma != "" {
						<span class="wcard__note">
							if note != "" {
								{ note }
							}
							if note != "" && lemma != "" {
								{ " · " }
							}
							if lemma != "" {
								<bdi lang="he" dir="rtl">{ lemma }</bdi>
							}
						</span>
					}
				}
				if meta := CardMeta(w.POS, w.Gender); meta != "" {
					<span class="wcard__pos">{ meta }</span>
				}
			} else if w.Translit != "" {
				<span class="wcard__sound" lang="he-Latn" dir="ltr">{ w.Translit }</span>
				<span class="wcard__pos">@E("how it sounds")</span>
			}
			if w.RootHref != "" {
				<a class="wcard__root" href={ templ.SafeURL(w.RootHref) } hx-boost="false">Root <bdi lang="he" dir="rtl">{ w.Root }</bdi></a>
			}
		</div>
	</details>
}

// flipHint is the quiet line under a teach prompt.
templ flipHint(a Activity) {
	<p class="wprompt-hint" lang="en">
		@Icon("flip", "")
		if a.Asking && a.PromptWord != "" {
			<span>@E("Tap a word for help. The word you are asked about only shows how it sounds.")</span>
		} else if a.Asking {
			<span>@E("Tap the word to hear how it sounds, then pick the meaning.")</span>
		} else {
			<span>@E("Tap a word to see what it means.")</span>
		}
	</p>
}

// showMeanings opens every card. Without script it is a plain link: closed
// steps go to ?meanings=all, and an open step drops that parameter. wcards.js
// turns the click into a toggle and adds role=button. The server sets neither
// role nor aria-pressed.
templ showMeanings(a Activity) {
	<div class="wline-tools">
		<a class="c-button" data-kind="text" href={ templ.SafeURL(a.MeaningsHref) } data-wcards-all>
			@Icon("eye", "")
			<span data-wcards-label>{ meaningsLabel(a.MeaningsOpen) }</span>
		</a>
	</div>
}

// choiceButton is one answer: a c-answer submit button. The lesson has no
// key badge: nothing in the player tells the learner to press 1, 2, or 3.
// The value is the lexeme id, never the pointed text.
templ choiceButton(c Choice) {
	@AnswerOptionWith(AnswerDefault, "", templ.Attributes{"type": "submit", "name": "answer", "value": c.Value}) {
		if c.Sentence {
			<span class="choice-he">@H(c.Text)</span>
		} else if c.Hebrew {
			@WordBlock(c.Text, c.Translit, "", "chip", "", true)
		} else {
			@E(c.Label)
		}
	}
}

// dialogueBlock is a conversation, one line at a time in spoken order. Each line
// has the speaker's fixed name, the words with sound and meaning, and a play
// control for that line alone. "Play the conversation" plays every line in order
// (dialogue.js). A line with no clip has no control, and is never played in the
// other speaker's voice. Nothing here is an answer option, so no c-answer.
templ dialogueBlock(d *Dialogue) {
	<div class="dlg" data-dialogue>
		<p class="dlg__bar">
			@ButtonWith(ButtonQuiet, templ.Attributes{"data-dlg-all": "", "aria-pressed": "false"}) {
				@E("Play the conversation")
			}
		</p>
		<ol class="dlg__lines">
			for _, line := range d.Lines {
				<li class={ dialogueLineClass(line.Speaker) } data-speaker={ line.Speaker } data-line={ Num(line.Index) }>
					<p class="dlg__who" lang="en">{ line.Name }</p>
					<div class="dlg__bubble">
						<div class={ dialogueWordsClass(line.Words) } dir="rtl">
							for _, word := range line.Words {
								@activityWord(word, "")
							}
						</div>
						if line.Audio != "" {
							<audio id={ dialogueClipID(line.Index) } src={ templ.SafeURL(line.Audio) } preload="none" data-dlg-clip={ Num(line.Index) }></audio>
							@AudioOrb("Play line "+Num(line.Index+1)+", "+line.Name, dialogueOrbAttrs(line.Index))
						}
					</div>
				</li>
			}
		</ol>
	</div>
	<script src={ Asset("/static/js/dialogue.js") } defer></script>
}

// wordClipRow is the no-JS play control for one word of a recall line or a
// flip card. The pointed word names the bar, then its transliteration when
// the line already shows it, so a recall target stays the pointed Hebrew and
// the bar until the answer. html.js hides .clip-rows; the orb under the word
// is the control then.
templ wordClipRow(w Word, audioID string) {
	<div class="clip-row">
		<p class="clip-row__label">
			<bdi class="clip-row__he" lang="he" dir="rtl">{ w.Text }</bdi>
			if w.ShowTranslit && w.Translit != "" {
				<span class="clip-row__sep">{ " · " }</span>
				<bdi class="clip-row__tr" lang="he-Latn" dir="ltr">{ w.Translit }</bdi>
			}
		</p>
		<div class="clip">
			<audio id={ audioID } src={ templ.SafeURL(w.Audio) } preload="none" controls aria-label={ "Play " + w.Text }></audio>
		</div>
	</div>
}

// lineClip is the line recording. A say reveal sets Autoplay so the model
// plays once after "I said it".
templ lineClip(a Activity) {
	@clipPlay("line-clip", a.Audio, a.AudioLabel, true, a.Autoplay)
}

// clip is one recording in the lesson player. The server always renders the
// native audio (the no-JS bar) and a button.orb. The orb is display:none
// until clips.js adds class js on html, which shows the orb and sets the bar
// to display:none. One of those two is the play control. hero is the line control.
// label is the button's accessible name, such as "Play אֲנִי" or "Play the line".
// A recall word and a flip card do not use this: the orb stays in the line
// and the bar is a wordClipRow, so the no-JS bar is not squeezed into the word column.
templ clip(id, src, label string, hero bool) {
	@clipPlay(id, src, label, hero, false)
}

templ clipPlay(id, src, label string, hero, auto bool) {
	<div class={ clipClass(hero) }>
		if auto {
			<audio id={ id } src={ templ.SafeURL(src) } preload="auto" controls autoplay data-autoplay></audio>
		} else {
			<audio id={ id } src={ templ.SafeURL(src) } preload="none" controls></audio>
		}
		@orbButton(orbClass(hero), label, src, "")
	</div>
}

// orbButton is the lesson orb. audioID, when set, names the audio element
// played for a word whose bar lives in .clip-rows. lang=en keeps the English
// name from inheriting a Hebrew line.
templ orbButton(className, label, src, audioID string) {
	if audioID != "" {
		<button type="button" class={ className } lang="en" aria-label={ label } data-label={ label } data-src={ src } data-audio={ audioID } data-state="idle">
			@orbGlyphs()
		</button>
	} else {
		<button type="button" class={ className } lang="en" aria-label={ label } data-label={ label } data-src={ src } data-state="idle">
			@orbGlyphs()
		</button>
	}
}

templ orbGlyphs() {
	<span class="orb__glyph orb__glyph--play">@Icon("play", "")</span>
	<span class="orb__glyph orb__glyph--load" aria-hidden="true"></span>
	<span class="orb__glyph orb__glyph--dots">@Icon("dots", "")</span>
	<span class="orb__glyph orb__glyph--stop">@Icon("stop", "")</span>
	<span class="orb__glyph orb__glyph--off">@Icon("audio-off", "")</span>
}
