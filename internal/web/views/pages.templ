package views

// Today is the learner home: due reviews, and one next lesson.
// The count is shell copy until the review queue is wired.
templ Today(h Home) {
	@Layout(h.Page()) {
		<article class="today" data-due={ h.DueText } data-known={ h.KnownText } if h.Placement != "" {
			data-placement={ h.Placement }
			data-placement-words={ h.PlacementWords }
			data-placement-level={ h.PlacementLevel }
			data-placement-rated={ h.PlacementRated }
			data-placement-at={ h.PlacementAt }
		}>
			<header class="today__head">
				<h1 lang={ h.Lang }>{ h.Heading }</h1>
			</header>
			<div class="today__cols">
				if h.Due > 0 {
					<section class="ink-card today-due" aria-labelledby="due-title">
						<p class="eyebrow" id="due-title" lang={ h.Lang }>{ h.DueKicker }</p>
						<p class="count"><bdi lang="en" dir="ltr">{ h.DueText }</bdi></p>
						<p class="ink-card__label" lang={ h.Lang }>{ h.DueLabel }</p>
						<p class="ink-card__hint" lang={ h.Lang }>{ h.DueHint }</p>
						<a class="btn btn-primary" href={ templ.SafeURL(h.Href("/review")) }>
							<svg class="icon" aria-hidden="true" focusable="false"><use href={ IconHref("play") }></use></svg>
							<span lang={ h.Lang }>{ h.Start }</span>
						</a>
					</section>
				} else {
					<section class="quiet-card quiet-card--due">
						<svg class="icon" aria-hidden="true" focusable="false"><use href={ IconHref("check") }></use></svg>
						<p class="quiet-card__line">
							@Pair(h.Lang, h.ZeroHE, h.ZeroEN)
						</p>
					</section>
				}
				if h.Lesson {
					<section class="lesson-card today-next" aria-labelledby="next-title">
						<p class="eyebrow" lang={ h.Lang }>{ h.NextKicker }</p>
						<h2 id="next-title" class="unit-title">
							@H(h.UnitTitle)
							if h.UnitGloss != "" {
								<span class="unit-gloss">@E(h.UnitGloss)</span>
							}
						</h2>
						if h.Situation != "" {
							@Situation(h.Situation)
						}
						<ul class="chips">
							for _, word := range h.Words {
								<li class="chip">
									@H(word.Text)
									if word.Gloss != "" {
										<span class="chip__gloss">@E(word.Gloss)</span>
									}
									if word.Gender != "" {
										<span class="gchip">@H(GenderLabel(word.Gender))</span>
									}
								</li>
							}
						</ul>
						<a class={ BtnClass(h.Due == 0) } href={ templ.SafeURL(h.Href("/lesson")) }>
							<svg class={ iconClass(h.Dir == "rtl") } aria-hidden="true" focusable="false"><use href={ IconHref("next") }></use></svg>
							<span lang={ h.Lang }>{ h.Open }</span>
						</a>
					</section>
				} else {
					<section class="quiet-card quiet-card--next">
						<svg class="icon" aria-hidden="true" focusable="false"><use href={ IconHref("lessons") }></use></svg>
						<p class="quiet-card__line">
							@Pair(h.Lang, h.NoneHE, h.NoneEN)
						</p>
						<p class="quiet-card__hint">
							@Pair(h.Lang, h.NoneMoreHE, h.NoneMoreEN)
						</p>
					</section>
				}
			</div>
		</article>
	}
}

templ Review(p Page, c ReviewCard) {
	@Layout(p) {
		<article class="sheet">
			<h1 lang={ p.Lang }>{ p.ReviewHeading }</h1>
			@ReviewBody(c)
		</article>
	}
}

templ ReviewBody(c ReviewCard) {
	<div id="review-card" data-kind={ c.Kind } data-card={ Num64(c.CardID) } data-pointed={ c.Pointed } data-unpointed={ c.Unpointed } data-show-unpointed={ Flag(c.ShowUnpointed) } data-translit={ c.Translit } data-index={ Num(c.Index) } data-total={ Num(c.Total) } data-answered={ Num(c.Answered) } data-correct={ Num(c.Correct) } data-retry={ Flag(c.Retry) } data-done={ Flag(c.Done) } data-revealed={ Flag(c.Revealed) }>
		if c.Done {
			if c.Answered == 0 {
				<p class="lede" lang={ c.Lang }>{ c.Lede }</p>
			} else {
				<p class="lede" lang="en" dir="ltr">
					<bdi lang="en" dir="ltr">{ Num(c.Correct) } / { Num(c.Answered) }</bdi>
				</p>
			}
		} else {
			<p class="count">
				if c.Kind == "en_he" {
					@E(c.Gloss)
				} else if c.ShowUnpointed {
					@H(c.Unpointed)
				} else {
					@H(c.Pointed)
				}
			</p>
			if c.Translit != "" {
				<p class="ink-card__hint">@E(c.Translit)</p>
			}
			if c.AudioURL != "" {
				<a href={ templ.SafeURL(c.AudioURL) }>
					<svg class="icon" aria-hidden="true" focusable="false"><use href={ IconHref("sound") }></use></svg>
				</a>
			}
			<p class="ink-card__hint">
				<bdi lang="en" dir="ltr">{ Num(c.Index) } / { Num(c.Total) }</bdi>
			</p>
			if c.Revealed {
				if c.Kind == "en_he" {
					<p class="ink-card__hint">
						if c.ShowUnpointed {
							@H(c.Unpointed)
						} else {
							@H(c.Pointed)
						}
					</p>
				} else if c.Gloss != "" {
					<p class="ink-card__hint">@E(c.Gloss)</p>
				}
				if c.Gender != "" {
					<span class="gchip">@H(GenderLabel(c.Gender))</span>
				}
				<form method="post" action="/_hx/review/grade" hx-post="/_hx/review/grade" hx-target="#review-card" hx-swap="outerHTML" hx-boost="false">
					<input type="hidden" name="_csrf" value={ c.CSRF }/>
					<input type="hidden" name="card_id" value={ Num64(c.CardID) }/>
					<button type="submit" class="btn btn-tonal" name="rating" value="1">@E("Again")</button>
					<button type="submit" class="btn btn-tonal" name="rating" value="2">@E("Hard")</button>
					<button type="submit" class="btn btn-tonal" name="rating" value="3">@E("Good")</button>
					<button type="submit" class="btn btn-tonal" name="rating" value="4">@E("Easy")</button>
				</form>
			} else {
				<form method="post" action="/_hx/review/reveal" hx-post="/_hx/review/reveal" hx-target="#review-card" hx-swap="outerHTML" hx-boost="false">
					<input type="hidden" name="_csrf" value={ c.CSRF }/>
					<input type="hidden" name="card_id" value={ Num64(c.CardID) }/>
					<button type="submit" class="btn btn-tonal">@E("Show")</button>
				</form>
			}
		}
	</div>
}

templ Progress(p ProgressPage) {
	@Layout(p.Page) {
		<article class="sheet" if p.Placement != "" {
			data-placement={ p.Placement }
			data-placement-words={ p.PlacementWords }
			data-placement-level={ p.PlacementLevel }
			data-placement-rated={ p.PlacementRated }
			data-placement-at={ p.PlacementAt }
		}>
			<h1 lang={ p.Lang }>{ p.ProgressHeading }</h1>
			<p class="lede" lang={ p.Lang }>{ p.ProgressLede }</p>
			<ul class="stats">
				<li>
					<span class="count"><bdi lang="en" dir="ltr">{ p.KnownText }</bdi></span>
					<span lang={ p.Lang }>{ p.WordsLabel }</span>
				</li>
				<li>
					<span class="count"><bdi lang="en" dir="ltr">{ p.UnitsText }</bdi></span>
					<span lang={ p.Lang }>{ p.UnitsLabel }</span>
				</li>
				<li>
					<span class="count"><bdi lang="en" dir="ltr">{ p.DueText }</bdi></span>
					<span lang={ p.Lang }>{ p.DueLabel }</span>
				</li>
			</ul>
		</article>
	}
}

// SignIn is the signed-out page. No rail, dock, or other navigation:
// logout lands here, and the only action is auth's Google start route.
// Copy follows the interface language. The button is Google's sign-in
// control, not the app's primary button.
templ SignIn(p Page) {
	<!DOCTYPE html>
	<html lang={ p.Lang } dir={ p.Dir } translate="no">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			@themeHead()
			<link rel="stylesheet" href="/static/css/tokens.css"/>
			<link rel="stylesheet" href="/static/css/base.css"/>
			<title>{ p.Title }</title>
		</head>
		<body>
			<main id="main" class="signin">
				<div class="signin__slate">
					<img class="signin__sky" src="/static/illustrations/hero-skyline-night.svg" alt="" aria-hidden="true"/>
					<p class="signin__word">
						@H(SignInWord)
						<span class="signin__gloss">@E(SignInWordGloss)</span>
					</p>
				</div>
				<section class="signin__card">
					<h1 class="brand signin__brand">
						<span class="brand__mark" aria-hidden="true">ע</span>
						<span class="brand__name">@H(AppName)</span>
					</h1>
					<p class="signin__title">
						if p.Lang == "en" {
							@E(SignInTitleEN)
						} else {
							@H(SignInTitleHE)
						}
					</p>
					<p class="signin__lede">
						if p.Lang == "en" {
							@E(SignInLedeEN)
						} else {
							@H(SignInLedeHE)
						}
					</p>
					<a class="gbtn" href={ templ.SafeURL(GoogleSignInStart) }>
						@googleMark()
						<span class="gbtn__label">
							if p.Lang == "en" {
								@E(SignInGoogleEN)
							} else {
								@H(SignInGoogleHE)
								@E("Google")
							}
						</span>
					</a>
				</section>
			</main>
		</body>
	</html>
}

// googleMark is the official multicolour G. The paths are unmodified.
templ googleMark() {
	<span class="gbtn__mark" aria-hidden="true">
		<svg class="gbtn__logo" viewBox="0 0 48 48" focusable="false">
			<path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
			<path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
			<path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
			<path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
			<path fill="none" d="M0 0h48v48H0z"></path>
		</svg>
	</span>
}

templ Lesson(p Page) {
	@Layout(p) {
		<article class="sheet">
			<h1 lang={ p.Lang }>{ p.LessonHeading }</h1>
			<p class="lede" lang={ p.Lang }>{ p.LessonLede }</p>
		</article>
	}
}
