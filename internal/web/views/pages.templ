package views

// Today is the learner home: due reviews, and one next lesson.
// The count is shell copy until the review queue is wired.
templ Today(h Home) {
	@Layout(h.Page()) {
		<article class="today">
			<header class="today__head">
				<h1 lang={ h.Lang }>{ h.Heading }</h1>
			</header>
			<div class="today__cols">
				if h.Due > 0 {
					<section class="ink-card today-due" aria-labelledby="due-title">
						<p class="eyebrow" id="due-title" lang={ h.Lang }>{ h.DueKicker }</p>
						<p class="count"><bdi lang="en" dir="ltr">{ h.DueText }</bdi></p>
						<p class="ink-card__label" lang={ h.Lang }>{ h.DueLabel }</p>
						<p class="ink-card__hint" lang={ h.Lang }>{ h.DueHint }</p>
						<a class="btn btn-primary" href={ templ.SafeURL(h.Href("/review")) }>
							<svg class="icon" aria-hidden="true" focusable="false"><use href={ IconHref("play") }></use></svg>
							<span lang={ h.Lang }>{ h.Start }</span>
						</a>
					</section>
				} else {
					<section class="quiet-card quiet-card--due">
						<svg class="icon" aria-hidden="true" focusable="false"><use href={ IconHref("check") }></use></svg>
						<p class="quiet-card__line">
							@Pair(h.Lang, h.ZeroHE, h.ZeroEN)
						</p>
					</section>
				}
				if h.Lesson {
					<section class="lesson-card today-next" aria-labelledby="next-title">
						<p class="eyebrow" lang={ h.Lang }>{ h.NextKicker }</p>
						<h2 id="next-title" class="unit-title" lang="he" dir="rtl">{ UnitTitle }</h2>
						@Situation(h.Situation)
						<ul class="chips">
							for _, word := range h.Words {
								<li class="chip">
									@H(word.Text)
									if word.Gender != "" {
										<span class="gchip">@H(GenderLabel(word.Gender))</span>
									}
								</li>
							}
						</ul>
						<a class={ BtnClass(h.Due == 0) } href={ templ.SafeURL(h.Href("/lesson")) }>
							<svg class={ iconClass(h.Dir == "rtl") } aria-hidden="true" focusable="false"><use href={ IconHref("next") }></use></svg>
							<span lang={ h.Lang }>{ h.Open }</span>
						</a>
					</section>
				} else {
					<section class="quiet-card quiet-card--next">
						<svg class="icon" aria-hidden="true" focusable="false"><use href={ IconHref("lessons") }></use></svg>
						<p class="quiet-card__line">
							@Pair(h.Lang, h.NoneHE, h.NoneEN)
						</p>
						<p class="quiet-card__hint">
							@Pair(h.Lang, h.NoneMoreHE, h.NoneMoreEN)
						</p>
					</section>
				}
			</div>
		</article>
	}
}

templ Review(p Page) {
	@Layout(p) {
		<article class="sheet">
			<h1 lang={ p.Lang }>{ p.ReviewHeading }</h1>
			<p class="lede" lang={ p.Lang }>{ p.ReviewLede }</p>
		</article>
	}
}

templ Progress(p Page) {
	@Layout(p) {
		<article class="sheet">
			<h1 lang={ p.Lang }>{ p.ProgressHeading }</h1>
			<p class="lede" lang={ p.Lang }>{ p.ProgressLede }</p>
			<ul class="stats">
				<li>
					<span class="count"><bdi lang="en" dir="ltr">0</bdi></span>
					<span lang={ p.Lang }>{ p.WordsLabel }</span>
				</li>
				<li>
					<span class="count"><bdi lang="en" dir="ltr">0</bdi></span>
					<span lang={ p.Lang }>{ p.UnitsLabel }</span>
				</li>
			</ul>
		</article>
	}
}

templ Lesson(p Page) {
	@Layout(p) {
		<article class="sheet vt-activity">
			<h1 lang={ p.Lang }>{ p.LessonHeading }</h1>
			<p class="lede" lang={ p.Lang }>{ p.LessonLede }</p>
		</article>
	}
}
