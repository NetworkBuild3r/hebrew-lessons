package views

// Today is the learner home: due reviews, and one next lesson.
// The count is shell copy until the review queue is wired.
templ Today(h Home) {
	@Layout(h.Page()) {
		<article class="today" data-due={ h.DueText } data-known={ h.KnownText } if h.PlacementState != "" {
			data-placement={ h.PlacementState }
			data-placement-words={ h.PlacementWords }
			data-placement-level={ h.PlacementLevel }
			data-placement-rated={ h.PlacementRated }
			data-placement-at={ h.PlacementAt }
		}>
			<header class="today__head">
				<h1 lang={ h.Lang }>{ h.Heading }</h1>
			</header>
			<div class="today__cols">
				if h.Placement == nil {
					<section class="today-place today-place--open" aria-labelledby="place-title">
						<p class="eyebrow" lang={ h.Lang }>{ PlacementFor(h.Lang).Kicker }</p>
						<h2 id="place-title" lang={ h.Lang }>{ PlacementFor(h.Lang).TakeTitle }</h2>
						<p class="today-place__hint" lang={ h.Lang }>{ PlacementFor(h.Lang).TakeHint }</p>
						<a class="btn btn-primary" href={ templ.SafeURL(h.Href("/placement")) }>
							<span lang={ h.Lang }>{ PlacementFor(h.Lang).TakeTitle }</span>
						</a>
					</section>
				}
				if h.Placement != nil && h.Placement.Active {
					<section class="today-place today-place--resume" aria-labelledby="place-title">
						<p class="eyebrow" lang={ h.Lang }>{ PlacementFor(h.Lang).Kicker }</p>
						<h2 id="place-title" lang={ h.Lang }>{ PlacementFor(h.Lang).TodayResume }</h2>
						<p class="today-place__hint" lang={ h.Lang }>{ PlacementFor(h.Lang).TakeHint }</p>
						<a class="btn btn-tonal" href={ templ.SafeURL(h.Href("/placement")) }>
							<span lang={ h.Lang }>{ PlacementFor(h.Lang).TodayResume }</span>
						</a>
					</section>
				}
				if h.Due > 0 {
					<section class="ink-card today-due" aria-labelledby="due-title">
						<p class="eyebrow" id="due-title" lang={ h.Lang }>{ h.DueKicker }</p>
						<p class="count"><bdi lang="en" dir="ltr">{ h.DueText }</bdi></p>
						<p class="ink-card__label" lang={ h.Lang }>{ h.DueLabel }</p>
						<p class="ink-card__hint" lang={ h.Lang }>{ h.DueHint }</p>
						<a class="btn btn-primary" href={ templ.SafeURL(h.Href("/review")) }>
							@Icon("play", "")
							<span lang={ h.Lang }>{ h.Start }</span>
						</a>
					</section>
				} else {
					<section class="quiet-card quiet-card--due">
						@Icon("check", "")
						<p class="quiet-card__line">
							@Pair(h.Lang, h.ZeroHE, h.ZeroEN)
						</p>
					</section>
				}
				if h.Lesson {
					<section class="lesson-card today-next" aria-labelledby="next-title">
						<p class="eyebrow" lang={ h.Lang }>{ h.NextKicker }</p>
						<h2 id="next-title" class="unit-title">
							@H(h.LessonTitle)
							if h.LessonGloss != "" {
								<span class="unit-gloss">@E(h.LessonGloss)</span>
							}
						</h2>
						if h.Situation != "" {
							@Situation(h.Situation)
						}
						<ul class="chips">
							for _, word := range h.Words {
								<li class="chip">
									@H(word.Text)
									if word.Gloss != "" {
										<span class="chip__gloss">@E(word.Gloss)</span>
									}
									if word.Gender != "" {
										<span class="gchip">@H(GenderLabel(word.Gender))</span>
									}
								</li>
							}
						</ul>
						<a class={ BtnClass(h.Due == 0) } href={ templ.SafeURL(h.Href(h.LessonHref)) }>
							@IconClass("next", iconClass(h.Dir == "rtl"), "")
							<span lang={ h.Lang }>{ h.Open }</span>
						</a>
					</section>
				} else {
					<section class="quiet-card quiet-card--next">
						<p class="eyebrow" lang={ h.Lang }>{ h.NextKicker }</p>
						@Icon("lessons", "")
						<p class="quiet-card__line">
							@Pair(h.Lang, h.NoneHE, h.NoneEN)
						</p>
						<p class="quiet-card__hint">
							@Pair(h.Lang, h.NoneMoreHE, h.NoneMoreEN)
						</p>
					</section>
				}
			</div>
		</article>
	}
}

templ Review(p Page, c ReviewCard) {
	@Layout(p) {
		<article class="review sheet">
			<h1 class="review__h1" lang={ p.Lang }>{ p.ReviewHeading }</h1>
			@ReviewBody(c)
			<script src="/static/js/activity.js" defer></script>
		</article>
	}
}

// ReviewBody is the card htmx swaps. A checked activity and the flashcard share
// one frame (activity.templ). Done is the end of the queue. The root keeps its
// data attributes and, with the frame, data-no-transition: see ActivityFrame.
templ ReviewBody(c ReviewCard) {
	<div id="review-card" data-kind={ c.Kind } data-card={ Num64(c.CardID) } data-pointed={ c.Pointed } data-unpointed={ c.Unpointed } data-show-unpointed={ Flag(c.ShowUnpointed) } data-index={ Num(c.Index) } data-total={ Num(c.Total) } data-answered={ Num(c.Answered) } data-correct={ Num(c.Correct) } data-retry={ Flag(c.Retry) } data-done={ Flag(c.Done) } data-revealed={ Flag(c.Revealed) } if c.Translit != "" && answerSide(c) {
		data-translit={ c.Translit }
	} if !c.Done {
		data-no-transition
	}>
		if c.Done {
			if c.Answered == 0 {
				<p class="lede" lang={ c.Lang }>{ c.Lede }</p>
			} else {
				<p class="lede" lang="en" dir="ltr">
					<bdi lang="en" dir="ltr">{ Num(c.Correct) } / { Num(c.Answered) }</bdi>
				</p>
			}
		} else if c.Act != nil {
			@ActivityFrame(*c.Act)
		} else {
			@flashFrame(c)
		}
	</div>
}

templ Progress(p ProgressPage) {
	@Layout(p.Page) {
		<article class="sheet" if p.Placement != "" {
			data-placement={ p.Placement }
			data-placement-words={ p.PlacementWords }
			data-placement-level={ p.PlacementLevel }
			data-placement-rated={ p.PlacementRated }
			data-placement-at={ p.PlacementAt }
		}>
			<h1 lang={ p.Lang }>{ p.ProgressHeading }</h1>
			<p class="lede" lang={ p.Lang }>{ p.ProgressLede }</p>
			<ul class="stats">
				<li>
					<span class="count"><bdi lang="en" dir="ltr">{ p.KnownText }</bdi></span>
					<span lang={ p.Lang }>{ p.WordsLabel }</span>
				</li>
				<li>
					<span class="count"><bdi lang="en" dir="ltr">{ p.UnitsText }</bdi></span>
					<span lang={ p.Lang }>{ p.UnitsLabel }</span>
				</li>
				<li>
					<span class="count"><bdi lang="en" dir="ltr">{ p.DueText }</bdi></span>
					<span lang={ p.Lang }>{ p.DueLabel }</span>
				</li>
			</ul>
		</article>
	}
}

// SignIn is the signed-out page. No rail, dock, or other navigation:
// logout lands here, and the only action is auth's Google start route.
// Copy follows the interface language. The button is Google's sign-in
// control, not the app's primary button.
templ SignIn(p Page) {
	<!DOCTYPE html>
	<html lang={ p.Lang } dir={ p.Dir } translate="no">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			@themeHead()
			<link rel="stylesheet" href="/static/css/tokens.css"/>
			<link rel="stylesheet" href="/static/css/base.css"/>
			@brandHead()
			<title>{ p.Title }</title>
		</head>
		<body>
			<main id="main" class="signin">
				<div class="signin__slate">
					<img class="signin__sky" src="/static/illustrations/hero-skyline-night.svg" alt="" aria-hidden="true"/>
					<p class="signin__word">
						@H(SignInWord)
						<span class="signin__gloss">@E(SignInWordGloss)</span>
					</p>
				</div>
				<section class="signin__card">
					<h1 class="brand signin__brand">
						<span class="brand__mark" aria-hidden="true">@BrandMark()</span>
						<span class="brand__name">@H(AppName)</span>
					</h1>
					<p class="signin__title">
						if p.Lang == "en" {
							@E(SignInTitleEN)
						} else {
							@H(SignInTitleHE)
						}
					</p>
					<p class="signin__lede">
						if p.Lang == "en" {
							@E(SignInLedeEN)
						} else {
							@H(SignInLedeHE)
						}
					</p>
					<a class="gbtn" href={ templ.SafeURL(GoogleSignInStart) }>
						@googleMark()
						<span class="gbtn__label">
							if p.Lang == "en" {
								@E(SignInGoogleEN)
							} else {
								@H(SignInGoogleHE)
								@E("Google")
							}
						</span>
					</a>
				</section>
			</main>
		</body>
	</html>
}
