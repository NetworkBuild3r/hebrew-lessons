package views

// Today is the learner home. The gold action is one session, "Today's session, about N
// minutes", or one line when nothing is due (INIT-038/SPEC-011). Placement and the
// check-in render only when their switches are on. The cards beside a switched-on
// feature stay quiet. There is no streak and no score.
templ Today(h Home) {
	@Layout(h.Page()) {
		<article class="today" data-action={ string(h.Today.Action) } data-due={ h.DueText } data-known={ h.KnownText } if h.PlacementState != "" {
			data-placement={ h.PlacementState }
			data-placement-words={ h.PlacementWords }
			data-placement-level={ h.PlacementLevel }
			data-placement-rated={ h.PlacementRated }
			data-placement-at={ h.PlacementAt }
		}>
			<header class="today__head">
				<div class="today__intro">
					<h1 lang={ h.Lang }>{ h.Heading }</h1>
					if h.Today.CanSayLine != "" {
						<p class="today__sub today-say"><a href={ templ.SafeURL(h.Href("/progress")) }>@E(h.Today.CanSayLine)</a></p>
					}
					if h.Today.DailyLine != "" {
						<p class="today__sub today-line">@E(h.Today.DailyLine)</p>
					}
				</div>
				<ul class="today-stats today-known">
					<li class="today-stat" data-stat="known">
						<span class="today-stat__figure" role="group" aria-label={ ProgressLabel(h.Lang, "Words you know") }>
							<span class="count"><bdi lang="en" dir="ltr">{ h.KnownText }</bdi></span>
						</span>
						<span class="today-stat__l">@ProgressT(h.Lang, "Words you know")</span>
					</li>
					if h.WaitingText != "" {
						<li class="today-stat" data-stat="waiting">
							<span class="today-stat__figure" role="group" aria-label={ ProgressLabel(h.Lang, LabelLearnedTodayCheckTomorrow) }>
								<span class="count"><bdi lang="en" dir="ltr">{ h.WaitingText }</bdi></span>
							</span>
							<span class="today-stat__l">@ProgressT(h.Lang, LabelLearnedTodayCheckTomorrow)</span>
						</li>
					}
				</ul>
			</header>
			if h.Today.Reported {
				<p class="today-notice" role="status">@T(h.Lang, "", "That lesson is hidden for you. Thank you for telling us.")</p>
			}
			<div class="today__grid" data-hero={ Flag(h.Today.Action != ActionNone) }>
				@todayHero(h)
				if h.Today.Action != ActionSession && h.Today.Action != ActionNone {
					<div class="today__side">
						@todayReviewCard(h)
						@todayLessonCard(h)
					</div>
				}
				if h.Today.Action == ActionSession {
					@todayElsewhere(h)
				}
			</div>
			for _, slip := range h.Today.Slips {
				@slipCard(h, slip)
			}
			if len(h.Today.Watch) > 0 {
				@watchCard(h)
			}
		</article>
	}
}

// todayHero is the one next action. ActionNone is one line and no button.
templ todayHero(h Home) {
	switch h.Today.Action {
		case ActionSession:
			<section class="ink-card today-hero today-session" aria-labelledby="hero-title">
				<p class="eyebrow">@E(SessionKicker(h.Today.SessionMinutes))</p>
				<h2 id="hero-title" class="today-session__title">@E(TodaySessionTitle(h.Due, h.Today.SessionMinutes, h.Today.CourseNew))</h2>
				<p class="ink-card__hint">@E(TodaySessionHint(h.Due, h.Today.CourseNew))</p>
				<a class="btn btn-primary" href={ templ.SafeURL(h.Href("/review")) }>
					@Icon("play", "")
					<span lang={ h.Lang }>{ h.Start }</span>
				</a>
			</section>
		case ActionNone:
			<p class="today-empty">@Pair(h.Lang, h.ZeroHE, h.ZeroEN)</p>
			<p class="today-speech"><a href={ templ.SafeURL(h.Href("/speech")) }>@T(h.Lang, "", "Common words")</a></p>
		case ActionResumePlacement:
			<section class="today-place today-place--resume" aria-labelledby="hero-title">
				<p class="eyebrow">@T(h.Lang, "", "Placement")</p>
				<h2 id="hero-title" class="today-hero__title">@T(h.Lang, "חֲזָרָה לַבְּדִיקָה", "Resume placement")</h2>
				<p class="today-place__hint">@T(h.Lang, "", "Pick up where you left off. Your answers so far are saved.")</p>
				<a class="btn btn-primary" href={ templ.SafeURL(h.Href("/placement")) }>
					@Icon("play", "")
					<span>@T(h.Lang, "חֲזָרָה לַבְּדִיקָה", "Resume placement")</span>
				</a>
			</section>
		case ActionStartPlacement:
			<section class="today-place today-place--open" aria-labelledby="hero-title">
				<p class="eyebrow">@T(h.Lang, "", "Start here")</p>
				<h2 id="hero-title" class="today-hero__title">@T(h.Lang, "בְּדִיקַת רָמָה", "Take the placement check")</h2>
				<p class="today-place__hint">@T(h.Lang, "", "A short check of the words you know, so lessons fit you. You can leave and come back.")</p>
				<a class="btn btn-primary" href={ templ.SafeURL(h.Href("/placement")) }>
					@Icon("play", "")
					<span>@T(h.Lang, "בְּדִיקַת רָמָה", "Take the placement check")</span>
				</a>
			</section>
		case ActionContinueLesson:
			<section class="ink-card today-hero" aria-labelledby="hero-title">
				<p class="eyebrow">@E(StepText(h.Today.Step, h.Today.Steps))</p>
				<h2 id="hero-title" class="unit-title today-hero__title">
					@LessonName(h.LessonTitle)
					if h.LessonGloss != "" {
						<span class="unit-gloss">@E(h.LessonGloss)</span>
					}
				</h2>
				<p class="ink-card__hint">@T(h.Lang, "", "You are partway through. Your place is saved.")</p>
				<a class="btn btn-primary" href={ templ.SafeURL(h.Href(h.LessonHref)) }>
					@IconClass("next", iconClass(h.Dir == "rtl"), "")
					<span>@T(h.Lang, "", "Continue lesson")</span>
				</a>
			</section>
		case ActionCheckin:
			<section class="ink-card today-hero" aria-labelledby="hero-title">
				<p class="eyebrow">
					if h.Today.CheckinLate {
						@E("Check-in · overdue")
					} else {
						@E("Check-in")
					}
				</p>
				<h2 id="hero-title" class="today-hero__title">@T(h.Lang, "", "Take the 3‑minute check-in")</h2>
				<p class="ink-card__hint">@E(CheckinHint(h.Today.CheckinSkill, h.Today.CheckinWeeks))</p>
				<form method="post" action="/_hx/placement/recheck" class="today-form">
					<input type="hidden" name="_csrf" value={ h.CSRF }/>
					<button type="submit" class="btn btn-primary">
						@Icon("play", "")
						<span>@T(h.Lang, "", "Start the check-in")</span>
					</button>
				</form>
			</section>
		case ActionReviews:
			<section class="ink-card today-hero" aria-labelledby="hero-title">
				<p class="eyebrow" lang={ h.Lang }>{ h.DueKicker }</p>
				<h2 id="hero-title" class="today-hero__title">
					<span class="count"><bdi lang="en" dir="ltr">{ h.DueText }</bdi></span>
					<span class="ink-card__label" lang={ h.Lang }>{ h.DueLabel }</span>
				</h2>
				<p class="ink-card__hint" lang={ h.Lang }>{ h.DueHint }</p>
				<a class="btn btn-primary" href={ templ.SafeURL(h.Href("/review")) }>
					@Icon("play", "")
					<span lang={ h.Lang }>{ h.Start }</span>
				</a>
			</section>
		case ActionNextLesson:
			<section class="ink-card today-hero today-next" aria-labelledby="hero-title">
				<p class="eyebrow" lang={ h.Lang }>{ h.NextKicker }</p>
				<h2 id="hero-title" class="unit-title today-hero__title">
					@LessonName(h.LessonTitle)
					if h.LessonGloss != "" {
						<span class="unit-gloss">@E(h.LessonGloss)</span>
					}
				</h2>
				if h.Situation != "" {
					@Situation(h.Situation)
				}
				@lessonChips(h)
				<a class="btn btn-primary" href={ templ.SafeURL(h.Href(h.LessonHref)) }>
					@IconClass("next", iconClass(h.Dir == "rtl"), "")
					<span lang={ h.Lang }>{ h.Open }</span>
				</a>
			</section>
	}
}

templ lessonChips(h Home) {
	<ul class="chips">
		for _, word := range h.Words {
			<li class="chip">
				@H(word.Text)
				if word.Gloss != "" {
					<span class="chip__gloss">@E(word.Gloss)</span>
				}
				if word.Gender != "" {
					<span class="gchip">@H(GenderLabel(word.Gender))</span>
				}
			</li>
		}
	</ul>
}

// todayElsewhere is the column beside the session on a wide screen and under it on a
// phone: the words that are slipping, and the two sections that explain what the
// sitting is doing. It is links only, so the session stays the one gold action.
templ todayElsewhere(h Home) {
	<aside class="today__aside" aria-label="Also today">
		if len(h.Today.Watch) > 0 {
			<section class="today-mini" aria-labelledby="aside-watch">
				<h2 id="aside-watch" class="today-mini__h">@T(h.Lang, "", "Words to watch")</h2>
				<p class="today-mini__note">@T(h.Lang, "", "These come back first.")</p>
				<ul class="today-mini__list">
					for _, w := range h.Today.Watch {
						<li class="today-mini__row" data-skill={ w.Skill }>
							<span class="today-mini__he">@H(w.Text)</span>
							if w.Gloss != "" {
								<span class="today-mini__gloss">@E(w.Gloss)</span>
							}
						</li>
					}
				</ul>
			</section>
		}
		<nav class="today-mini" aria-labelledby="aside-go">
			<h2 id="aside-go" class="today-mini__h">@T(h.Lang, "", "Where to go")</h2>
			<ul class="today-mini__list">
				<li>
					<a class="today-mini__link" href={ templ.SafeURL(h.Href("/lessons")) }>
						@Icon("lessons", "")
						<span class="today-mini__text">
							<span class="today-mini__t">@uiRun(h.Lang, h.Lessons)</span>
							<span class="today-mini__note">@T(h.Lang, "", "The five most common words at a time.")</span>
						</span>
						@IconClass("next", iconClass(h.Dir == "rtl"), "")
					</a>
				</li>
				<li>
					<a class="today-mini__link" href={ templ.SafeURL(h.Href("/learn/alefbet")) }>
						@Icon("compass", "")
						<span class="today-mini__text">
							<span class="today-mini__t">@T(h.Lang, "", "The letters")</span>
							<span class="today-mini__note">@T(h.Lang, "", "Every letter, and the vowels.")</span>
						</span>
						@IconClass("next", iconClass(h.Dir == "rtl"), "")
					</a>
				</li>
			</ul>
		</nav>
	</aside>
}

// todayReviewCard is what is due, when the hero is not the review. A quiet link goes to the
// review. With nothing due it says so.
templ todayReviewCard(h Home) {
	if h.Today.Action != ActionReviews {
		if h.Due > 0 {
			<section class="c-card today-review" aria-labelledby="due-title">
				<p class="eyebrow" id="due-title" lang={ h.Lang }>{ h.DueKicker }</p>
				<p class="count"><bdi lang="en" dir="ltr">{ h.DueText }</bdi></p>
				<p class="today-note">@E(h.Today.DailyLine)</p>
				<a class="btn btn-tonal" href={ templ.SafeURL(h.Href("/review")) }>
					<span lang={ h.Lang }>{ h.Start }</span>
				</a>
			</section>
		} else {
			<section class="quiet-card quiet-card--due">
				@Icon("check", "")
				<p class="quiet-card__line">
					@Pair(h.Lang, h.ZeroHE, h.ZeroEN)
				</p>
			</section>
		}
	}
}

// todayLessonCard is the next lesson, when the hero is not that lesson. With no lesson it
// says so and names what to do instead.
templ todayLessonCard(h Home) {
	if h.Today.Action != ActionNextLesson && h.Today.Action != ActionContinueLesson {
		if h.Lesson {
			<section class="lesson-card today-next" aria-labelledby="next-title">
				<p class="eyebrow" lang={ h.Lang }>{ h.NextKicker }</p>
				<h2 id="next-title" class="unit-title">
					@LessonName(h.LessonTitle)
					if h.LessonGloss != "" {
						<span class="unit-gloss">@E(h.LessonGloss)</span>
					}
				</h2>
				if h.Situation != "" {
					@Situation(h.Situation)
				}
				@lessonChips(h)
				<a class="btn btn-tonal" href={ templ.SafeURL(h.Href(h.LessonHref)) }>
					@IconClass("next", iconClass(h.Dir == "rtl"), "")
					<span lang={ h.Lang }>{ h.Open }</span>
				</a>
			</section>
		} else {
			<section class="quiet-card quiet-card--next">
				<p class="eyebrow" lang={ h.Lang }>{ h.NextKicker }</p>
				@Icon("lessons", "")
				<p class="quiet-card__line">
					@Pair(h.Lang, h.NoneHE, h.NoneEN)
				</p>
				<p class="quiet-card__hint">
					@Pair(h.Lang, h.NoneMoreHE, h.NoneMoreEN)
				</p>
				<p class="quiet-card__hint">@T(h.Lang, "", "Until then, look over what you know.")</p>
				<a class="today-link" href={ templ.SafeURL(h.Href("/progress")) }>
					<span>@uiRun(h.Lang, h.Progress)</span>
					@IconClass("next", iconClass(h.Dir == "rtl"), "")
				</a>
			</section>
		}
	}
}

// slipCard is a band-slip alert. It stays for seven days after the daily job writes the
// event. The button builds a review set of that band's words that are struggling or regressed.
templ slipCard(h Home, s SlipAlert) {
	<section class="today-slip" aria-labelledby={ "slip-" + Num(s.Band) } data-band={ Num(s.Band) } data-day={ s.Day }>
		<span class="today-slip__mark" aria-hidden="true">@Icon("tip", "")</span>
		<div class="today-slip__text">
			<h2 id={ "slip-" + Num(s.Band) } class="today-h2">@E("Some level " + Num(s.Level) + " words are slipping")</h2>
			if s.Words > 0 {
				<p class="today-note">@E(CountText(s.Words, "word", "words") + " you knew need another look.")</p>
			} else {
				<p class="today-note">@E("They look steady again. Nothing to fix right now.")</p>
			}
		</div>
		if s.Words > 0 {
			<form method="post" action="/_hx/review/band" class="today-form">
				<input type="hidden" name="_csrf" value={ h.CSRF }/>
				<input type="hidden" name="band" value={ Num(s.Band) }/>
				<button type="submit" class="btn btn-tonal">
					<span>@E("Review these words")</span>
				</button>
			</form>
		}
	</section>
}

// watchCard lists the words the learner is struggling with, each with the skill that fails.
templ watchCard(h Home) {
	<section class="c-card today-watch" aria-labelledby="watch-title">
		<h2 id="watch-title" class="today-h2">@T(h.Lang, "", "Words to watch")</h2>
		<p class="today-note">@T(h.Lang, "", "Your next lessons will reuse these.")</p>
		<ul class="watch">
			for _, w := range h.Today.Watch {
				<li class="watch__item" data-skill={ w.Skill }>
					<span class="watch__he">@H(w.Text)</span>
					if w.Gloss != "" {
						<span class="watch__gloss">@E(w.Gloss)</span>
					}
					<span class="c-chip watch__skill">@E(SkillLabel(w.Skill))</span>
				</li>
			}
		</ul>
	</section>
}
