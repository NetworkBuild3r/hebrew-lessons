package views

// SpeechRung is one step on the coverage map.
type SpeechRung struct {
	Words, Share string
}

// CourseNext is one common word the learner has not met.
type CourseNext struct {
	Pointed, English, Times string
}

// CourseSlip is a common word that is slipping or giving trouble.
type CourseSlip struct {
	Pointed, English, Cause string
}

// CourseLost is one word the weekly report says was lost, with its cause in plain words.
type CourseLost struct {
	Word, Cause string
}

// CourseLastWeek is the course block of the newest weekly report.
type CourseLastWeek struct {
	WeekOf             string
	Met, Days, Minutes int
	Gained             []string
	Lost               []CourseLost
}

// CoursePage is the learner's place on the common-word list.
type CoursePage struct {
	Page
	Met, Place, Waiting          int
	Share, Reason                string
	Next                         []CourseNext
	Slipping                     []CourseSlip
	Minutes, Days, MetWeek, Slipped int
	Climb                        []SpeechRung
	Last                         *CourseLastWeek
}

templ Speech(v CoursePage) {
	@Layout(v.Page) {
		<article class="speech" data-speech="1">
			<h1>Common words</h1>
			if v.Met == 0 {
				<p>You have not started the common words yet.</p>
			} else {
				<p>You have met { v.Met } of the common words. The ones you know cover about { v.Share } of the words in Hebrew subtitles.</p>
			}
			<p>
				<a class="btn btn-primary" href={ templ.SafeURL(v.UI.Href("/review")) }>
					if v.Waiting > 0 {
						Learn { v.Waiting } new words
					} else {
						Review
					}
				</a>
			</p>
			if v.Waiting == 0 && v.Reason != "" {
				<p>{ v.Reason }</p>
			}
			if len(v.Next) > 0 {
				<h2>Next words</h2>
				<ul data-next="1">
					for _, w := range v.Next {
						<li>
							<span lang="he" dir="rtl">{ w.Pointed }</span>
							<span lang="en">{ w.English }</span>
							if w.Times != "" {
								<span>{ w.Times } times in every 1,000 words</span>
							}
						</li>
					}
				</ul>
			}
			if len(v.Slipping) > 0 {
				<h2>Slipping</h2>
				<ul data-slipping="1">
					for _, w := range v.Slipping {
						<li>
							<span lang="he" dir="rtl">{ w.Pointed }</span>
							<span lang="en">{ w.English }</span>
							if w.Cause != "" {
								<span>{ w.Cause }</span>
							}
						</li>
					}
				</ul>
				<form method="post" action={ templ.SafeURL(v.UI.Href("/_hx/review/course")) }>
					<input type="hidden" name="_csrf" value={ v.CSRF }/>
					<button type="submit">Practise these</button>
				</form>
			}
			<h2>This week</h2>
			<p data-week="1">{ v.Minutes } minutes, { v.Days } study days, { v.MetWeek } met, { v.Slipped } slipped.</p>
			if v.Last != nil {
				<h2>Last week</h2>
				<section data-last-week="1">
					<p>Week of { v.Last.WeekOf }</p>
					<p>{ v.Last.Met } new words, { v.Last.Days } study days, { v.Last.Minutes } minutes</p>
					if len(v.Last.Gained) > 0 {
						<ul>
							for _, w := range v.Last.Gained {
								<li lang="he" dir="rtl">{ w }</li>
							}
						</ul>
					}
					if len(v.Last.Lost) > 0 {
						<ul>
							for _, w := range v.Last.Lost {
								<li><span lang="he" dir="rtl">{ w.Word }</span> <span>{ w.Cause }</span></li>
							}
						</ul>
					}
				</section>
			}
			<h2>How far the common words go</h2>
			<ul data-climb="1">
				for _, s := range v.Climb {
					<li>{ s.Words } words cover { s.Share }</li>
				}
			</ul>
			<p data-follow="1">You can follow a line when you already know about 95 of every 100 words in it. That figure is from reading, and using it for listening is a guess.</p>
		</article>
	}
}
