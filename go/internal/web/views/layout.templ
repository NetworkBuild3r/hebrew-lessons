package views

import "github.com/NetworkBuild3r/hebrew-lessons/go/internal/web/views/components"

// Layout is the signed-in document shell. The document stays Hebrew and RTL.
// Two pre-paint scripts read the same localStorage keys the app uses.
// Theme follows the OS until a saved light, dark, or auto choice says
// otherwise. data-theme is the resolved light or dark value. data-theme-choice
// keeps auto so the switch can show it. That default is provisional:
// ADR-0015 still defaults Node to light, and this page does not change
// app-shell.js. The switch handler is the only other script. No audio player
// is added; buttons carry the hooks the existing player already listens for.

templ Layout(doc Doc) {
	<!DOCTYPE html>
	<html lang="he" dir="rtl" translate="no" class="has-hebrew-shell" data-page-he={ doc.PageHe } data-page-en={ doc.PageEn }>
		<head>
			<meta charset="UTF-8"/>
			@templ.Raw("<script>\n        try {\n            var uiLang = localStorage.getItem('hebrew-ui-lang');\n            document.documentElement.setAttribute('data-ui-lang', uiLang === 'he' ? 'he' : 'en');\n        } catch (e) { /* English until a script can read the choice */ }\n    </script>")
			@templ.Raw("<script>(function(){var choice='auto';try{choice=localStorage.getItem('hebrew-theme')||'auto';}catch(e){}if(choice!=='light'&&choice!=='dark'&&choice!=='auto')choice='auto';var resolved=choice;if(choice==='auto'){var dark=false;try{dark=window.matchMedia('(prefers-color-scheme: dark)').matches;}catch(e2){}resolved=dark?'dark':'light';}var root=document.documentElement;root.setAttribute('data-theme',resolved);root.setAttribute('data-theme-choice',choice);})();</script>")
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="google" content="notranslate"/>
			<meta name="theme-color" content="#1d4ed8"/>
			<title>{ doc.Title }</title>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<link rel="icon" href="/shared/brand/favicon.svg" type="image/svg+xml"/>
			<link rel="icon" href="/shared/brand/favicon-32.png" type="image/png" sizes="32x32"/>
			<link rel="icon" href="/shared/brand/favicon-16.png" type="image/png" sizes="16x16"/>
			<link rel="apple-touch-icon" href="/shared/brand/apple-touch-icon.png"/>
			<link rel="preload" as="font" type="font/woff2" href="/shared/fonts/noto-sans-hebrew-hebrew.woff2" crossorigin="anonymous"/>
			<link rel="stylesheet" href="/shared/worksheet.css"/>
		</head>
		<body class={ doc.BodyClass }>
			<div id="app-shell">
				@components.Shell(doc.CurrentNav)
			</div>
			<main class="wrap" id="app-main" tabindex="-1" data-route-ready={ doc.RouteReady }>
				@doc.Main
			</main>
			<div id="app-route-announce" class="visually-hidden" aria-live="polite" aria-atomic="true">{ doc.Announce }</div>
			@templ.Raw("<script>(function(){var order=['light','dark','auto'];function resolve(choice){if(choice==='dark')return 'dark';if(choice==='light')return 'light';try{return window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}catch(e){return 'light';}}function apply(choice,persist){if(order.indexOf(choice)<0)choice='auto';var root=document.documentElement;root.setAttribute('data-theme-choice',choice);root.setAttribute('data-theme',resolve(choice));if(persist){try{localStorage.setItem('hebrew-theme',choice);}catch(e){}}var radios=document.querySelectorAll('.theme-switch [role=\"radio\"]');for(var i=0;i<radios.length;i++){radios[i].setAttribute('aria-checked',radios[i].getAttribute('data-theme-choice')===choice?'true':'false');}}document.addEventListener('click',function(ev){var btn=ev.target&&ev.target.closest&&ev.target.closest('.theme-switch [role=\"radio\"]');if(!btn)return;apply(btn.getAttribute('data-theme-choice'),true);});document.addEventListener('keydown',function(ev){var btn=ev.target&&ev.target.closest&&ev.target.closest('.theme-switch [role=\"radio\"]');if(!btn)return;var dir=0;if(ev.key==='ArrowRight'||ev.key==='ArrowDown')dir=1;if(ev.key==='ArrowLeft'||ev.key==='ArrowUp')dir=-1;if(!dir)return;var radios=[].slice.call(btn.parentNode.querySelectorAll('[role=\"radio\"]'));var i=radios.indexOf(btn);var next=radios[(i+dir+radios.length)%radios.length];if(!next)return;next.focus();apply(next.getAttribute('data-theme-choice'),true);ev.preventDefault();});try{var mq=window.matchMedia('(prefers-color-scheme: dark)');var onChange=function(){if((document.documentElement.getAttribute('data-theme-choice')||'auto')==='auto')apply('auto',false);};if(mq.addEventListener)mq.addEventListener('change',onChange);else if(mq.addListener)mq.addListener(onChange);}catch(e){}apply(document.documentElement.getAttribute('data-theme-choice')||'auto',false);})();</script>")
		</body>
	</html>
}

// Doc is the per-page shell data. Main is the heading plus the view.
type Doc struct {
	Title      string
	BodyClass  string
	PageHe     string
	PageEn     string
	Announce   string
	CurrentNav string
	RouteReady string
	Main       templ.Component
}
