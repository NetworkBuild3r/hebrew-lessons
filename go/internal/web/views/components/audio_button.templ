package components

// AudioButton is the player hook. data-say / data-clip are the guide names.
// data-speak / data-audio are the names shared/player/core.js already listens
// for, so this page does not add a second player.
templ AudioButton(say string, clip string) {
	if say != "" || clip != "" {
		<button type="button" class="audio-btn" aria-label="השמעה" data-say={ say } data-clip={ clip } data-speak={ say } data-audio={ clip }>
			<svg class="icon" width="24" height="24" aria-hidden="true" focusable="false">
				<use href="/shared/brand/sprite.svg#icon-sound"></use>
			</svg>
		</button>
	}
}
