package components

type navItem struct {
	ID   string
	Href string
	He   string
	En   string
	Icon string
}

// learnerNav matches app-shell.js NAV for a reader who is not an admin.
func learnerNav() []navItem {
	return []navItem{
		{ID: "today", Href: "/", He: "היום", En: "Today", Icon: "today"},
		{ID: "lessons", Href: "/lessons/", He: "שיעורים", En: "Lessons", Icon: "lessons"},
		{ID: "guides", Href: "/guides/", He: "מדריכים", En: "Guides", Icon: "guides"},
		{ID: "verbs", Href: "/verbs/", He: "פעלים", En: "Verbs", Icon: "verbs"},
		{ID: "review", Href: "/review/", He: "חזרה", En: "Review", Icon: "review"},
		{ID: "words", Href: "/words/", He: "מילים", En: "Words", Icon: "words"},
		{ID: "progress", Href: "/progress/", He: "התקדמות", En: "Progress", Icon: "progress"},
	}
}

templ navIcon(name string) {
	if name != "" {
		<svg class={ "icon hebrew-icon hebrew-icon-" + name } width="20" height="20" aria-hidden="true" focusable="false">
			<use href={ "/shared/brand/sprite.svg#icon-" + name }></use>
		</svg>
	}
}

templ navLabel(item navItem) {
	@navIcon(item.Icon)
	<span class="hebrew-shell-label">@Pair(item.He, item.En)</span>
}

templ navLink(item navItem, current string) {
	if item.ID == current {
		<a class="hebrew-shell-link" href={ templ.SafeURL(item.Href) } aria-current="page" data-nav={ item.ID }>
			@navLabel(item)
		</a>
	} else {
		<a class="hebrew-shell-link" href={ templ.SafeURL(item.Href) } data-nav={ item.ID }>
			@navLabel(item)
		</a>
	}
}

// Shell is the rail and dock. The account button stays out until a session
// can fill the name. Language and theme are forms, so they work with no script.
// hx-post is the HTMX path; the same action works as a plain POST.
templ Shell(current string) {
	@shellInner(current, UIFrom(ctx))
}

templ shellInner(current string, ui UI) {
	<div class="hebrew-shell ui-chrome" dir="rtl" lang="he">
		<div class="hebrew-shell-inner">
			<a class="hebrew-brand" href="/" data-brand>
				<img class="hebrew-logo-mark" src="/shared/brand/mark-a.svg" width="30" height="30" alt="" decoding="async"/>
				<span class="hebrew-brand-text ui-pair"><span class="hebrew-brand-he ui-he" lang="he">דֶּרֶךְ עִבְרִית</span><span class="hebrew-brand-en ui-en" lang="en" dir="ltr">Hebrew Way</span></span>
			</a>
			<nav class="hebrew-shell-nav" data-ui-aria-he="ניווט ראשי" data-ui-aria-en="Main" aria-label="ניווט ראשי">
				for _, item := range learnerNav() {
					@navLink(item, current)
				}
			</nav>
			<div class="hebrew-shell-sync" data-shell-sync aria-live="polite"></div>
			<div class="hebrew-shell-account">
				<form class="ui-lang" method="post" action="/_hx/ui" hx-post="/_hx/ui" hx-swap="none" role="group" data-ui-aria-he="שפת הממשק" data-ui-aria-en="Interface language" aria-label={ LangGroupLabel(ui.Lang) }>
					<input type="hidden" name="csrf" value={ ui.CSRF }/>
					<input type="hidden" name="next" value={ ui.Next }/>
					<button type="submit" name="lang" value="en" class={ "ui-lang-btn", templ.KV("is-on", ui.Lang == "en") } data-ui-lang-set="en" aria-pressed={ Pressed(ui.Lang == "en") }>EN</button>
					<button type="submit" name="lang" value="he" class={ "ui-lang-btn", templ.KV("is-on", ui.Lang == "he") } data-ui-lang-set="he" aria-pressed={ Pressed(ui.Lang == "he") }>עב</button>
				</form>
				<form class="theme-switch" method="post" action="/_hx/ui" hx-post="/_hx/ui" hx-swap="none" role="radiogroup" data-ui-aria-he="ערכת נושא" data-ui-aria-en="Theme" aria-label={ ThemeGroupLabel(ui.Lang) }>
					<input type="hidden" name="csrf" value={ ui.CSRF }/>
					<input type="hidden" name="next" value={ ui.Next }/>
					<svg class="icon" width="18" height="18" aria-hidden="true" focusable="false"><use href="/shared/brand/sprite.svg#icon-theme"></use></svg>
					<button type="submit" name="theme" value="light" aria-pressed={ Pressed(ui.Theme == "light") }>בהיר</button>
					<button type="submit" name="theme" value="dark" aria-pressed={ Pressed(ui.Theme == "dark") }>כהה</button>
					<button type="submit" name="theme" value="auto" aria-pressed={ Pressed(ui.Theme == "auto") }>אוטומטי</button>
				</form>
			</div>
		</div>
	</div>
}
