package components

// EmptyGuides is the shelf when no published guide is visible.
// English UI shows the Hebrew line above the English heading. Hebrew UI
// hides that line and uses the Hebrew heading.
templ EmptyGuides() {
	<div class="card guides-state" data-guides-state="empty">
		<div class="empty-art">
			<img src="/shared/brand/illustrations/empty-guides.svg" alt="" aria-hidden="true" width="320" height="240"/>
		</div>
		<p class="empty-he" lang="he" dir="rtl">עֲדַיִן אֵין מַדְרִיכִים</p>
		<h2 class="empty-title empty-title-en" lang="en" dir="ltr">No guides published yet</h2>
		<h2 class="empty-title empty-title-he" lang="he" dir="rtl">עֲדַיִן אֵין מַדְרִיכִים</h2>
		<p class="empty-body empty-body-en" lang="en" dir="ltr">Guides are short explainers — grammar, usage and reading tips with audio. When one is published it will show up here.</p>
		<p class="empty-body empty-body-he" lang="he" dir="rtl">מדריכים הם הסברים קצרים: דקדוק, שימוש וטיפים לקריאה, עם שמע. מדריך שמתפרסם מופיע כאן.</p>
		<p class="empty-actions">
			<a class="btn btn-primary" href="/">@Pair("לשיעור של היום", "Go to today’s lesson")</a>
			<a class="btn btn-ghost" href="/words/">@Pair("לעיון במילים", "Browse words")</a>
		</p>
	</div>
}

// ErrorGuides is the shelf when the catalog cannot be read.
templ ErrorGuides() {
	<div class="card guides-state" data-guides-state="error" role="alert">
		<p>שגיאה בטעינת המדריכים. <span lang="en" dir="ltr">(Could not load guides.)</span></p>
	</div>
}

// MissingPlan is the plan page when the id is not a slug.
templ MissingPlan() {
	<div class="card" role="alert">
		<p>חסר מזהה תוכנית. <span lang="en" dir="ltr">(Missing plan id.)</span></p>
		<p><a class="btn btn-primary" href="/guides/">@Pair("למדריכים", "Back to Guides")</a></p>
	</div>
}

// PlanNotFound is the plan page when that guide is not visible.
templ PlanNotFound() {
	<div class="card" role="alert">
		<p>התוכנית לא נמצאה. <span lang="en" dir="ltr">(That plan was not found.)</span></p>
		<p><a class="btn btn-primary" href="/guides/">@Pair("למדריכים", "Back to Guides")</a></p>
	</div>
}
