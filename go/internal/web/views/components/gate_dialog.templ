package components

import "github.com/NetworkBuild3r/hebrew-lessons/go/internal/web/path"

// GateSheet is the once-per-unit warning. It is not open in the markup.
// The host calls showModal() after the swap, so Escape, the backdrop, and
// Close are the native dialog. Go anyway and Test out record the ack, then
// follow the link.
templ GateSheet(d GateDialog) {
	<dialog class="gate-sheet" data-trigger={ d.TriggerID } aria-labelledby="gate-title">
		if d.Known {
			<p id="gate-title" class="gate-sheet__title">@Pair(d.TitleHe, d.TitleEn)</p>
		} else {
			<p id="gate-title" class="gate-sheet__title">@Pair("עוד לא סיימת את היחידה הקודמת.", "You haven't finished the earlier unit.")</p>
		}
		<div class="gate-sheet__actions">
			if d.Next != "" {
				<a class="btn btn-primary" href={ templ.SafeURL(d.Next) } hx-post={ gateURL(d.UnitID) } hx-swap="none" hx-vals='{"confirm":"1"}' hx-on::after-request="if(event.detail.successful)location.assign(this.getAttribute('href'))">@Pair("להמשיך בכל זאת", "Go anyway")</a>
			}
			if d.Checkpoint != "" {
				<a class="btn" href={ templ.SafeURL(d.Checkpoint) } hx-post={ gateURL(d.UnitID) } hx-swap="none" hx-vals='{"confirm":"1"}' hx-on::after-request="if(event.detail.successful)location.assign(this.getAttribute('href'))">@Pair("מבחן יציאה", "Test out")</a>
			}
			<form method="dialog">
				<button type="submit" class="btn btn-ghost">@Pair("סגירה", "Close")</button>
			</form>
		</div>
	</dialog>
}

// GateAckBody is the opening response: the sheet only. Links stay on
// data-gate="warn" until the learner confirms.
templ GateAckBody(d GateDialog) {
	@GateSheet(d)
}

// GateConfirmed is the confirm response. Go anyway and Test out replace
// this unit's links with data-gate="open". Close does not.
templ GateConfirmed(nodes []path.Node) {
	for _, n := range nodes {
		@PathNodeOOB(n)
	}
}
