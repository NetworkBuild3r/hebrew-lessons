package components

// GateSheet is the once-per-unit warning. Go anyway and Test out are
// ordinary links, so the learner still moves on when the ack did not stick.
templ GateSheet(d GateDialog) {
	<div class="gate-scrim">
		<dialog class="gate-sheet" open data-unit-id={ d.UnitID } aria-labelledby="gate-title">
			if d.Known {
				<p id="gate-title" class="gate-sheet__title">@Pair(d.TitleHe, d.TitleEn)</p>
			} else {
				<p id="gate-title" class="gate-sheet__title">@Pair("עוד לא סיימת את היחידה הקודמת.", "You haven't finished the earlier unit.")</p>
			}
			<div class="gate-sheet__actions">
				if d.Next != "" {
					<a class="btn btn-primary" href={ templ.SafeURL(d.Next) }>@Pair("תִּמְשִׁיךְ בְּכָל זֹאת", "Go anyway")</a>
				}
				if d.Checkpoint != "" {
					<a class="btn" href={ templ.SafeURL(d.Checkpoint) }>@Pair("מִבְחַן יְצִיאָה", "Test out")</a>
				}
				<form method="dialog">
					<button type="submit" class="btn btn-ghost">@Pair("סגירה", "Close")</button>
				</form>
			</div>
		</dialog>
	</div>
}
