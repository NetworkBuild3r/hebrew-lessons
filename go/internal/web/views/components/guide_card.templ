package components

// Card is one guide on the shelf. Cover is one of the six illustration names.
// Status, minutes, and example counts are omitted until the catalog stores them.
type Card struct {
	PlanID    string
	LessonID  string
	Href      string
	Cover     string
	Letter    string
	Topic     string
	Title     string
	TitleLang string
	TitleDir  string
	HeTitle   string
	// Speak is Hebrew the card can voice when there is no separate HeTitle.
	Speak string
}

templ GuideCard(g Card) {
	<article class="lesson-card guide-card" data-recipe="guide" data-plan-id={ g.PlanID } data-lesson-id={ g.LessonID }>
		<div class="guide-card__cover" aria-hidden="true">
			<img src={ "/shared/brand/illustrations/" + g.Cover + ".svg" } alt="" width="320" height="160" loading="lazy" decoding="async"/>
			if g.Letter != "" {
				<span class="guide-card__letter" lang="he" dir="rtl">{ g.Letter }</span>
			}
		</div>
		<div class="guide-card__body">
			<span class="recipe-chip guide-card__meta" data-recipe="guide"><span class="visually-hidden">מדריך <span lang="en" dir="ltr">Guide</span> · </span><bdi>{ g.Topic }</bdi></span>
			<div class="guide-card__title-row">
				<h3 lang={ g.TitleLang } dir={ g.TitleDir }><a class="lesson-link" href={ templ.SafeURL(g.Href) }>{ g.Title }</a></h3>
				if g.HeTitle == "" && g.Speak != "" {
					@AudioButton(g.Speak, "")
				}
			</div>
			if g.HeTitle != "" {
				<div class="guide-card__he-row">
					@AudioButton(g.HeTitle, "")
					<p class="guide-card__he" lang="he" dir="rtl">{ g.HeTitle }</p>
				</div>
			}
		</div>
	</article>
}
