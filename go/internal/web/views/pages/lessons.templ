package pages

import (
	"github.com/NetworkBuild3r/hebrew-lessons/go/internal/web/views"
	"github.com/NetworkBuild3r/hebrew-lessons/go/internal/web/views/components"
)

templ allLessonsLink() {
	<a class="btn btn-ghost" href="/lessons/all">@components.Pair("כל השיעורים (רשימה)", "All lessons (list)")</a>
}

templ lessonsView(page LearnPage) {
	if page.Failed {
		<div class="card" role="alert" data-path-state="error">
			<p>שגיאה בטעינת המסלול. <span lang="en" dir="ltr">(Could not load the path.)</span></p>
		</div>
	} else {
		<div class="path-layout">
			<div class="path-main">
				for _, u := range page.Snap.Units {
					@components.UnitSection(u)
				}
			</div>
			<aside class="path-key">
				@components.PathKey()
			</aside>
			<button type="button" class="btn btn-ghost path-key-open" popovertarget="path-key-sheet">@components.Pair("מקרא", "Key")</button>
			<div id="path-key-sheet" class="path-key-sheet" popover>
				@components.PathKey()
			</div>
			<div id="gate-host"></div>
		</div>
	}
}

// LessonsFragment is the path, for an HX-Request read.
templ LessonsFragment(page LearnPage) {
	@lessonsView(page)
}

// LessonsPage is GET /lessons/.
templ LessonsPage(page LearnPage) {
	@views.Layout(views.Doc{
		Title:      "שיעורים — Lessons · דֶּרֶךְ עִבְרִית",
		BodyClass:  "hebrew-spa has-hebrew-shell lessons-page",
		PageHe:     "שיעורים",
		PageEn:     "Lessons",
		Announce:   "שיעורים",
		CurrentNav: "lessons",
		RouteReady: "lessons",
		HTMX:       true,
		CSRFHeader: csrfHeader(page.CSRF),
		Goal:       learnGoal(page.Snap),
		Main:       lessonsMain(page),
	})
}

templ lessonsMain(page LearnPage) {
	@components.PageHeading(components.Heading{
		He:      "שיעורים",
		En:      "Lessons",
		SubHe:   "הַמַּסְלוּל — יחידה אחר יחידה.",
		SubEn:   "Your path — one unit at a time.",
		Actions: allLessonsLink(),
	})
	<div id="lessons-app" class="spa-view">
		@lessonsView(page)
	</div>
}
