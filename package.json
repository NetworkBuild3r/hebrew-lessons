  "private": true,
  "scripts": {
    "start": "node server/start.js",
    "web": "node server/web.js",
    "mcp": "node mcp/http.js",
    "test": "node --test test/*.test.js",
    "db:migrate": "node scripts/db.js migrate",
    "db:backup": "node scripts/db.js backup",
    "db:backup-sqlite": "node scripts/backup-db.js",
    "db:check": "node scripts/db.js check",
    "stage:counts": "node scripts/stage-counts.js",
    "user": "node scripts/user.js",
    "audio": "node scripts/generate-audio.js",
    "audio:dry": "node scripts/generate-audio.js --dry-run",
    "audio:inventory": "node scripts/audio-inventory.js inventory",
    "audio:verify": "node scripts/audio-inventory.js verify",
    "vocab-index": "node scripts/build-vocab-index.js"
