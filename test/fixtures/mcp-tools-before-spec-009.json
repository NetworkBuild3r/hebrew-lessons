    }
  },
  "list_lexicon": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "q": {
          "description": "Gloss or key fragment.",
          "type": "string",
          "maxLength": 80
        },
        "pos": {
          "description": "Part of speech, such as noun or verb.",
          "type": "string",
          "maxLength": 32
        },
        "binyan": {
          "description": "Binyan, such as paal.",
          "type": "string",
          "maxLength": 32
        },
        "tense": {
          "description": "Tense, such as past.",
          "type": "string",
          "maxLength": 32
        },
        "rootClass": {
          "description": "Root class, such as regular.",
          "type": "string",
          "maxLength": 32
        },
        "verified": {
          "description": "Filter by the person's verified flag. You cannot change it.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 1
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "cursor": {
          "description": "Key of the last entry on the previous page.",
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  "list_users": {
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  "list_words": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "description": "Only words from this lesson.",
          "type": "string"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  "move_block": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
