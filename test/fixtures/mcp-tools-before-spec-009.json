  "set_lesson_visibility": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "Lesson folder name."
        },
        "visibility": {
          "description": "\"everyone\", \"hidden\", or { users: [\"username\", ...] }."
        }
      },
      "required": [
        "slug",
        "visibility"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "idempotentHint": true
    }
  },
  "set_lexicon_verified": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "verified": {
          "type": "boolean"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": null
  },
  "upload_media": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Media id: 1-64 lowercase letters, digits, and single hyphens."
        },
        "bytes": {
          "type": "string",
          "maxLength": 7000000,
          "description": "Base64 image bytes. A file path is not accepted."
        },
        "altText": {
          "description": "English alt-text draft. Empty alt cannot be approved later.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "bytes"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": null
  },
  "upsert_lesson": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "New folder name: lowercase words separated by hyphens."
        },
        "title": {
          "description": "Shelf title. Defaults to worksheet.title.",
          "type": "string"
        },
        "subtitle": {
          "description": "Shelf subtitle. Defaults to worksheet.subtitle.",
          "type": "string"
        },
        "blurb": {
          "description": "One line under the card on the home page.",
          "type": "string"
        },
        "level": {
          "description": "basic, intermediate, or advanced.",
          "type": "string"
        },
        "worksheet": {
          "description": "Lesson object: title, level, activities, plus vocab, fill, grammar, reading, askFriend sections to include."
        },
        "audio": {
          "description": "Generate ElevenLabs audio after a successful write. Defaults to true. Pass false to skip.",
          "type": "boolean"
        },
        "visibility": {
          "description": "Optional. \"everyone\" or { users: [\"username\", ...] }. Requires MCP_AUTH_TOKEN. Omit to leave new lessons hidden and existing lessons unchanged."
        }
      },
      "required": [
        "slug",
        "worksheet"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "idempotentHint": true
    }
  },
  "upsert_lexicon_entries": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "entries": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "kind": {
                "type": "string",
                "maxLength": 16
              },
              "lemma_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "lemmaKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "gloss_en": {
                "type": "string",
                "maxLength": 120
              },
              "glossEn": {
                "type": "string",
                "maxLength": 120
              },
              "pos": {
                "type": "string",
                "maxLength": 32
              },
              "root": {
                "type": "string",
                "maxLength": 32
              },
              "binyan": {
                "type": "string",
                "maxLength": 32
              },
              "root_class": {
                "type": "string",
                "maxLength": 32
              },
              "rootClass": {
                "type": "string",
                "maxLength": 32
              },
              "tense": {
                "type": "string",
                "maxLength": 32
              },
              "cell": {
                "type": "string",
                "maxLength": 16
              },
              "translit": {
                "type": "string",
                "maxLength": 80
              },
              "accept": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 60
                }
              }
            },
            "required": [
              "key"
            ]
          }
        },
        "expectedRev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "entries",
        "expectedRev"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": null
  }
}
