    },
    "annotations": null
  },
  "plan_image": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "One ordinary object or action."
        },
        "count": {
          "description": "How many images the estimate covers. Omit for one.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "prompt"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
