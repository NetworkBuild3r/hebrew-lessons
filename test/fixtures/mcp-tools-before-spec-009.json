{
  "add_library_words": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The learner's account username."
        },
        "words": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": "Lexicon keys only. Not glosses."
        }
      },
      "required": [
        "username",
        "words"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": null
  },
  "check_text_coverage": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The learner's account username."
        },
        "text": {
          "type": "string",
          "maxLength": 4096,
          "description": "Hebrew text to score. At most 4000 characters are accepted."
        }
      },
      "required": [
        "username",
        "text"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  "generate_image": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "The same prompt that was dry-run."
        },
        "confirm": {
          "type": "boolean",
          "description": "Must be true. Any other value does not call the provider."
        },
        "estimate": {
          "type": "number",
          "description": "Dollar estimate from plan_image for one image."
        },
        "id": {
          "type": "string",
          "description": "Media id for the pending image."
        },
        "altText": {
          "description": "English alt-text draft.",
          "type": "string"
        }
      },
      "required": [
        "prompt",
        "confirm",
        "estimate",
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": null
  },
  "generate_lesson_audio": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "Lesson folder name."
        },
        "forceSentences": {
          "description": "Regenerate sentence/story/grammar/question clips even when text is unchanged. Never regenerates words.",
          "type": "boolean"
        }
      },
      "required": [
        "slug"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "idempotentHint": true
    }
  },
  "get_learner_profile": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The learner's account username."
        }
      },
      "required": [
        "username"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  "get_lesson": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "Folder name, such as shai-date-indirect-speech."
        }
      },
      "required": [
        "slug"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  "get_lexicon_entry": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Lexicon key, the same string as a profile word_id."
        }
      },
      "required": [
        "key"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  "insert_block": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Plan id."
        },
        "path": {
          "type": "string",
          "description": "Id path of the lesson, such as units/unit-1/lessons/cafe-order."
        },
        "index": {
          "description": "Destination index. Omit to append.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "block": {
          "description": "Block object to insert."
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Revision from the last read. Must match the stored working copy."
        }
      },
      "required": [
        "id",
        "path",
        "block",
        "expectedRevision"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": null
  },
  "list_activity_types": {
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "annotations": {
