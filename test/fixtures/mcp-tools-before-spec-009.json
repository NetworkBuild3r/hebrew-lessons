  "remove_block": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Plan id."
        },
        "path": {
          "type": "string",
          "description": "Id path of the block to remove."
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Revision from the last read. Must match the stored working copy."
        }
      },
      "required": [
        "id",
