        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": null
  },
  "set_field": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Plan id."
        },
        "path": {
          "type": "string",
          "description": "Id path of the part. Empty string is the plan document."
        },
        "field": {
          "type": "string",
          "description": "Field name on that part."
        },
        "value": {
          "description": "New value."
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Revision from the last read. Must match the stored working copy."
        }
      },
      "required": [
        "id",
